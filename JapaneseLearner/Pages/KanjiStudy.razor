@page "/kanji"
@inject IKanjiService KanjiService
@inject NavigationManager Navigation

<PageTitle>Luyện Kanji - Japanese Learner</PageTitle>

<div class="kanji-study-container">
    <div class="study-header">
        <div class="study-header-title">
            <div class="study-header-icon kanji-icon" aria-hidden="true">
                <span>漢</span>
            </div>
            <div>
                <h1>Luyện Kanji</h1>
                <p class="study-header-sub">Gõ âm On hoặc Kun của Kanji hiển thị</p>
            </div>
        </div>
        <div class="study-header-stats">
            <div class="stat-box stat-correct">
                <span class="stat-num">@correctCount</span>
                <span class="stat-label">Đúng</span>
            </div>
            <div class="stat-box stat-wrong">
                <span class="stat-num">@wrongCount</span>
                <span class="stat-label">Sai</span>
            </div>
        </div>
    </div>

    <div class="filter-row">
        <span class="filter-label">JLPT:</span>
        <button class="filter-btn @(selectedLevel == "All" ? "active" : "")" @onclick="@(() => SwitchLevel("All"))">All</button>
        <button class="filter-btn @(selectedLevel == "N5" ? "active" : "")" @onclick="@(() => SwitchLevel("N5"))">N5</button>
    </div>

    @if (isLoading)
    {
        <div class="loading-wrap">
            <FluentProgressRing />
        </div>
    }
    else if (availableKanji.Count == 0)
    {
        <div class="empty-state">
            <div class="empty-icon"><FluentIcon Icon="@(Icons.Regular.Size20.Compose)" /></div>
            <h3>Chưa có dữ liệu</h3>
            <p>Vui lòng thêm Kanji từ trang Admin để bắt đầu học.</p>
            <FluentButton Appearance="@Appearance.Accent" Href="/admin" Class="mt-4">
                Đến Admin
            </FluentButton>
        </div>
    }
    else
    {
        <div class="type-indicator">
            <span class="level-badge">@currentKanji?.JLPTLevel</span>
            <span class="stroke-badge">@currentKanji?.StrokeCount nét</span>
        </div>

        <div class="study-card @(isCorrect == true ? "card-correct" : isCorrect == false ? "card-wrong" : "")">
            <div class="kanji-display">
                <span class="kanji-char">@currentKanji?.Kanji</span>
            </div>
        </div>

        @if (isCorrect == true)
        {
            <div class="feedback feedback-correct">
                <span class="feedback-icon"><FluentIcon Icon="@(Icons.Regular.Size20.Checkmark)" /></span>
                Chính xác!
                <span class="meaning-hint">(@currentKanji?.Meaning)</span>
            </div>
            <div class="reading-display">
                <div class="reading-box">
                    <span class="reading-label">Âm On</span>
                    <span class="reading-value">@currentKanji?.OnYomi</span>
                </div>
                <div class="reading-box">
                    <span class="reading-label">Âm Kun</span>
                    <span class="reading-value">@currentKanji?.KunYomi</span>
                </div>
            </div>
        }
        else if (isCorrect == false)
        {
            <div class="feedback feedback-wrong">
                <span class="feedback-icon"><FluentIcon Icon="@(Icons.Regular.Size20.Dismiss)" /></span>
                <span>Âm On: <strong>@currentKanji?.OnYomi</strong></span>
                <span>Âm Kun: <strong>@currentKanji?.KunYomi</strong></span>
                @if (!string.IsNullOrWhiteSpace(currentKanji?.Meaning))
                {
                    <span class="meaning-hint">(@currentKanji.Meaning)</span>
                }
            </div>
        }

        <div class="input-row">
            <div class="input-wrap">
                <FluentTextField @ref="inputRef" @bind-Value="userInput"
                                 Placeholder="Nhập On hoặc Kun Yomi..."
                                 Class="romaji-input"
                                 Disabled="@(isCorrect == true)"
                                 @onkeydown="HandleKeyDown" />
            </div>
            @if (isCorrect == true || isCorrect == false)
            {
                <FluentButton Appearance="@Appearance.Accent" OnClick="NextKanji" Class="action-btn">
                    Tiếp →
                </FluentButton>
            }
            else
            {
                <FluentButton Appearance="@Appearance.Accent" OnClick="CheckAnswer"
                             Disabled="string.IsNullOrWhiteSpace(userInput)" Class="action-btn">
                    Kiểm tra
                </FluentButton>
            }
        </div>
    }
</div>

<style>
    .kanji-study-container {
        max-width: 520px;
        margin: 0 auto;
    }
    .kanji-icon {
        background: var(--icon-kanji-bg, #E63946);
    }
    .filter-row {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 16px;
        justify-content: center;
    }
    .filter-label {
        font-size: 0.85rem;
        font-weight: 600;
        color: var(--text-secondary);
    }
    .filter-btn {
        padding: 6px 16px;
        border-radius: 20px;
        border: 2px solid var(--tab-btn-border);
        background: var(--tab-btn-bg);
        color: var(--tab-btn-text);
        font-size: 0.8rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
        font-family: inherit;
    }
    .filter-btn:hover {
        border-color: var(--tab-btn-hover-border);
    }
    .filter-btn.active {
        background: var(--tab-btn-active-bg);
        border-color: var(--tab-btn-active-bg);
        color: var(--tab-btn-active-text);
    }
    .type-indicator {
        text-align: center;
        margin-bottom: 12px;
        display: flex;
        justify-content: center;
        gap: 8px;
    }
    .level-badge {
        display: inline-block;
        padding: 4px 14px;
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 700;
        background: var(--badge-level-bg, #E63946);
        color: var(--badge-level-text, white);
    }
    .stroke-badge {
        display: inline-block;
        padding: 4px 14px;
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 600;
        background: var(--badge-stroke-bg, #457b9d);
        color: var(--badge-stroke-text, white);
    }
    .kanji-display {
        min-height: 140px;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .kanji-char {
        font-size: 6rem;
        line-height: 1.2;
        font-family: var(--font-family);
        color: var(--text-primary);
        transition: transform 0.2s;
        user-select: none;
    }
    .study-card:hover .kanji-char {
        transform: scale(1.02);
    }
    .reading-display {
        display: flex;
        gap: 12px;
        margin: 12px auto;
        max-width: 400px;
    }
    .reading-box {
        flex: 1;
        background: var(--bg-card);
        border-radius: 12px;
        padding: 10px;
        text-align: center;
        box-shadow: var(--shadow-sm);
    }
    .reading-label {
        display: block;
        font-size: 0.7rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: var(--text-secondary);
        margin-bottom: 4px;
    }
    .reading-value {
        font-size: 1.1rem;
        font-weight: 600;
        color: var(--text-primary);
    }
    .meaning-hint {
        display: block;
        font-size: 0.85rem;
        font-weight: 400;
        margin-top: 4px;
        opacity: 0.8;
    }
    .input-row {
        align-items: stretch;
    }
    .action-btn {
        height: auto;
    }
</style>

@code {
    private List<JapaneseKanji> availableKanji = new();
    private JapaneseKanji? currentKanji;
    private string userInput = "";
    private bool? isCorrect;
    private string selectedLevel = "All";
    private int correctCount;
    private int wrongCount;
    private bool isLoading = true;
    private FluentTextField inputRef = default!;

    protected override async Task OnInitializedAsync()
    {
        await LoadKanji();
        isLoading = false;
    }

    private async Task LoadKanji()
    {
        availableKanji = await KanjiService.GetByLevelAsync(selectedLevel);
        await PickRandomKanji();
    }

    private async Task PickRandomKanji()
    {
        if (availableKanji.Count == 0) return;
        var rng = new Random();
        currentKanji = availableKanji[rng.Next(availableKanji.Count)];
        userInput = "";
        isCorrect = null;
        if (inputRef != null)
            inputRef.FocusAsync();
    }

    private async Task CheckAnswer()
    {
        if (currentKanji == null || string.IsNullOrWhiteSpace(userInput)) return;

        var normalized = userInput.Trim().ToLowerInvariant();

        var onMatch = !string.IsNullOrWhiteSpace(currentKanji.OnYomi) &&
                      SplitReadings(currentKanji.OnYomi).Any(r => normalized == r);
        var kunMatch = !string.IsNullOrWhiteSpace(currentKanji.KunYomi) &&
                       SplitReadings(currentKanji.KunYomi).Any(r => normalized == r);

        if (onMatch || kunMatch)
        {
            isCorrect = true;
            correctCount++;
            StateHasChanged();
            await Task.Delay(1500);
            await PickRandomKanji();
        }
        else
        {
            isCorrect = false;
            wrongCount++;
        }
    }

    private static List<string> SplitReadings(string readings)
    {
        return readings
            .Split(new[] { '・', '、', ',', ' ' }, StringSplitOptions.RemoveEmptyEntries)
            .Select(r => r.Trim().ToLowerInvariant())
            .Where(r => !string.IsNullOrEmpty(r))
            .Distinct()
            .ToList();
    }

    private async Task NextKanji()
    {
        await PickRandomKanji();
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            if (isCorrect == true || isCorrect == false)
                await NextKanji();
            else
                await CheckAnswer();
        }
    }

    private async Task SwitchLevel(string level)
    {
        selectedLevel = level;
        await LoadKanji();
    }
}
