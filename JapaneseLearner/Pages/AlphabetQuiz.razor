@page "/alphabet/quiz"
@inject ICharService CharService
@inject NavigationManager Navigation

<PageTitle>Trắc nghiệm bảng chữ cái - Japanese Learner</PageTitle>

<div class="kana-quiz-container">
    <div class="study-header">
        <div class="study-header-title">
            <div class="study-header-icon kana-icon" aria-hidden="true">
                <span>あ</span>
            </div>
            <div>
                <h1>Trắc nghiệm bảng chữ cái</h1>
                <p class="study-header-sub">@(isKanaToRomajiMode ? "Chọn Romaji đúng của ký tự" : "Chọn ký tự đúng của Romaji")</p>
            </div>
        </div>
        <div class="study-header-stats">
            <div class="stat-box stat-correct">
                <span class="stat-num">@correctCount</span>
                <span class="stat-label">Đúng</span>
            </div>
            <div class="stat-box stat-wrong">
                <span class="stat-num">@wrongCount</span>
                <span class="stat-label">Sai</span>
            </div>
        </div>
    </div>

    <div class="mode-toggle-row">
        <button class="mode-btn @(isKanaToRomajiMode ? "active" : "")"
                aria-pressed="@(isKanaToRomajiMode ? "true" : "false")"
                @onclick="@(() => SwitchMode(true))">
            <span class="mode-icon">あ</span>
            <span>Kana → Romaji</span>
        </button>
        <button class="mode-btn @(!isKanaToRomajiMode ? "active" : "")"
                aria-pressed="@(!isKanaToRomajiMode ? "true" : "false")"
                @onclick="@(() => SwitchMode(false))">
            <span class="mode-icon">ABC</span>
            <span>Romaji → Kana</span>
        </button>
    </div>

    @if (isLoading)
    {
        <div class="loading-wrap">
            <FluentProgressRing />
        </div>
    }
    else if (availableChars.Count == 0)
    {
        <div class="empty-state">
            <div class="empty-icon"><FluentIcon Icon="@(Icons.Regular.Size20.BookContacts)" /></div>
            <h3>Chưa có dữ liệu</h3>
            <p>Không có chữ cái để học. Vui lòng thêm dữ liệu từ Admin.</p>
            <FluentButton Appearance="@Appearance.Accent" Class="mt-4" @onclick="@(() => Navigation.NavigateTo("/admin"))">
                Đến Admin
            </FluentButton>
        </div>
    }
    else
    {
        <div class="filter-row">
            <FluentSelect TOption="string" @bind-Value="selectedType"
                          @bind-Value:after="OnTypeChanged"
                          Class="filter-select">
                <FluentOption TOption="string" Value="@("All")">Tất cả</FluentOption>
                <FluentOption TOption="string" Value="@("Hiragana")">Hiragana</FluentOption>
                <FluentOption TOption="string" Value="@("Katakana")">Katakana</FluentOption>
            </FluentSelect>
        </div>

        <div class="study-card @(isCorrect == true ? "card-correct" : isCorrect == false ? "card-wrong" : "")">
            @if (isKanaToRomajiMode)
            {
                <div class="kana-display">
                    <span class="kana-char">@currentChar?.Character</span>
                </div>
            }
            else
            {
                <div class="romaji-display">
                    <span class="romaji-text">@currentChar?.Romaji</span>
                </div>
            }
        </div>

        @if (isCorrect == true)
        {
            <div class="feedback feedback-correct">
                <span class="feedback-icon"><FluentIcon Icon="@(Icons.Regular.Size20.Checkmark)" /></span>
                Chính xác! (@currentChar?.Romaji)
            </div>
        }
        else if (isCorrect == false)
        {
            <div class="feedback feedback-wrong">
                <span class="feedback-icon"><FluentIcon Icon="@(Icons.Regular.Size20.Dismiss)" /></span>
                @if (currentChar != null)
                {
                    <span>Đáp án đúng: <strong>@currentChar.Romaji</strong></span>
                }
            </div>
        }
        else
        {
            <div class="feedback feedback-prompt">
                @(isKanaToRomajiMode ? "Chọn Romaji đúng của ký tự trên" : "Chọn ký tự đúng của Romaji trên")
            </div>
        }

        <div class="options-grid">
            @foreach (var opt in options)
            {
                <button class="option-btn @(selectedOption == opt ? (opt.IsCorrect ? "opt-correct" : "opt-wrong") : "")
                        @(selectedOption != null ? "opt-disabled" : "")"
                        disabled="@(selectedOption != null)"
                        @onclick="() => SelectAnswer(opt)">
                    <span class="option-text">@opt.Display</span>
                </button>
            }
        </div>
    }
</div>

<style>
