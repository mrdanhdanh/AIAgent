@code {
    private class AnswerOption
    {
        public string Display { get; set; } = string.Empty;
        public bool IsCorrect { get; set; }
    }

    private List<JapaneseChar> availableChars = new();
    private JapaneseChar? currentChar;
    private List<AnswerOption> options = new();
    private AnswerOption? selectedOption;
    private bool? isCorrect;
    private int correctCount;
    private int wrongCount;
    private bool isKanaToRomajiMode = true;
    private string selectedType = "All";
    private bool isLoading = true;
    private static readonly Random _rng = Random.Shared;
    private CancellationTokenSource? _timerCts;

    protected override async Task OnInitializedAsync()
    {
        await LoadCharsAsync();
        isLoading = false;
    }

    private async Task LoadCharsAsync()
    {
        availableChars = await CharService.GetByTypeAsync(selectedType);
        PickRandomChar();
    }

    private void PickRandomChar()
    {
        if (availableChars.Count == 0) return;

        currentChar = availableChars[_rng.Next(availableChars.Count)];
        selectedOption = null;
        isCorrect = null;

        options = GenerateOptions(currentChar);
    }

    private List<AnswerOption> GenerateOptions(JapaneseChar correct)
    {
        if (isKanaToRomajiMode)
        {
            var pool = availableChars
                .Where(k => k.Romaji != correct.Romaji)
                .Select(k => k.Romaji)
                .Distinct()
                .ToList();

            var distractors = new List<string>();
            while (distractors.Count < 3 && pool.Count > 0)
            {
                var idx = _rng.Next(pool.Count);
                distractors.Add(pool[idx]);
                pool.RemoveAt(idx);
            }
            while (distractors.Count < 3)
            {
                distractors.Add("???");
            }

            var result = new List<AnswerOption>
            {
                new AnswerOption { Display = correct.Romaji, IsCorrect = true }
            };
            result.AddRange(distractors.Select(d => new AnswerOption { Display = d, IsCorrect = false }));
            Shuffle(result);
            return result;
        }
        else
        {
            var pool = availableChars
                .Where(k => k.Character != correct.Character)
                .Select(k => k.Character)
                .Distinct()
                .ToList();

            var distractors = new List<string>();
            while (distractors.Count < 3 && pool.Count > 0)
            {
                var idx = _rng.Next(pool.Count);
                distractors.Add(pool[idx]);
                pool.RemoveAt(idx);
            }
            while (distractors.Count < 3)
            {
                distractors.Add("???");
            }

            var result = new List<AnswerOption>
            {
                new AnswerOption { Display = correct.Character, IsCorrect = true }
            };
            result.AddRange(distractors.Select(d => new AnswerOption { Display = d, IsCorrect = false }));
            Shuffle(result);
            return result;
        }
    }

    private static void Shuffle<T>(List<T> list)
    {
        for (int i = list.Count - 1; i > 0; i--)
        {
            int j = _rng.Next(i + 1);
            (list[i], list[j]) = (list[j], list[i]);
        }
    }

    private async Task SelectAnswer(AnswerOption opt)
    {
        if (selectedOption != null) return;

        selectedOption = opt;
        isCorrect = opt.IsCorrect;

        if (opt.IsCorrect)
            correctCount++;
        else
            wrongCount++;

        _timerCts?.Cancel();
        _timerCts = new CancellationTokenSource();
        try
        {
            await Task.Delay(3000, _timerCts.Token);
            PickRandomChar();
            StateHasChanged();
        }
        catch (TaskCanceledException)
        {
        }
    }

    private void SwitchMode(bool toKanaToRomaji)
    {
        if (isKanaToRomajiMode == toKanaToRomaji) return;
        isKanaToRomajiMode = toKanaToRomaji;
        _timerCts?.Cancel();
        PickRandomChar();
        StateHasChanged();
    }

    private async Task OnTypeChanged()
    {
        await LoadCharsAsync();
        StateHasChanged();
    }
}
