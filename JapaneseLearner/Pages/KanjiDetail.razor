@page "/kanji/{Id:int}"
@inject IKanjiService KanjiService
@inject NavigationManager Navigation

<PageTitle>@(kanji?.Kanji ?? "Kanji") - Chi tiết Kanji</PageTitle>

<div class="kanji-detail-container">
    @if (isLoading)
    {
        <div class="loading-wrap">
            <FluentProgressRing />
        </div>
    }
    else if (kanji == null)
    {
        <div class="empty-state">
            <div class="empty-icon"><FluentIcon Icon="@(Icons.Regular.Size20.Compose)" /></div>
            <h3>Không tìm thấy Kanji</h3>
            <FluentButton Appearance="@Appearance.Accent" Class="mt-4" @onclick="@(() => Navigation.NavigateTo("/kanji"))">
                ← Quay lại danh sách
            </FluentButton>
        </div>
    }
    else
    {
        <div class="detail-header">
            <FluentButton Appearance="@Appearance.Lightweight" Class="back-btn" @onclick="@(() => Navigation.NavigateTo("/kanji"))">
                ← Quay lại
            </FluentButton>
        </div>

        <div class="kanji-hero">
            <span class="kanji-hero-char">@kanji.Kanji</span>
        </div>

        <div class="kanji-info-section">
            <div class="info-row">
                <div class="info-card">
                    <span class="info-label">Âm On (音読み)</span>
                    <span class="info-value on-yomi">@kanji.OnYomi</span>
                </div>
                <div class="info-card">
                    <span class="info-label">Âm Kun (訓読み)</span>
                    <span class="info-value kun-yomi">@kanji.KunYomi</span>
                </div>
            </div>
            <div class="info-row">
                <div class="info-card">
                    <span class="info-label">Nghĩa</span>
                    <span class="info-value meaning">@kanji.Meaning</span>
                </div>
                <div class="info-card">
                    <span class="info-label">Số nét</span>
                    <span class="info-value stroke-count">@kanji.StrokeCount</span>
                </div>
            </div>
            <div class="info-row">
                <div class="info-card">
                    <span class="info-label">JLPT Level</span>
                    <span class="info-value level-badge-detail">@kanji.JLPTLevel</span>
                </div>
            </div>
        </div>

        @if (kanji.Examples != null && kanji.Examples.Count > 0)
        {
            <div class="section">
                <h3 class="section-title">Ví dụ từ vựng</h3>
                <div class="examples-list">
                    @foreach (var ex in kanji.Examples)
                    {
                        <div class="example-item">@ex</div>
                    }
                </div>
            </div>
        }

        @if (kanji.Strokes != null && kanji.Strokes.Count > 0)
        {
            <div class="section">
                <h3 class="section-title">Thứ tự nét</h3>
                <div class="stroke-controls">
                    <FluentButton Appearance="@Appearance.Lightweight" OnClick="PrevStroke"
                                 Disabled="@(currentStrokeIndex <= 0)">
                        ← Nét trước
                    </FluentButton>
                    <span class="stroke-indicator">Nét @(currentStrokeIndex + 1) / @kanji.Strokes.Count</span>
                    <FluentButton Appearance="@Appearance.Lightweight" OnClick="NextStroke"
                                 Disabled="@(currentStrokeIndex >= kanji.Strokes.Count - 1)">
                        Nét sau →
                    </FluentButton>
                </div>
                <div class="stroke-svg-wrap">
                    <svg viewBox="0 0 100 100" class="stroke-svg">
                        @for (int i = 0; i <= currentStrokeIndex && i < kanji.Strokes.Count; i++)
                        {
                            <path d="@kanji.Strokes[i]" fill="none" stroke="var(--text-primary)" stroke-width="3"
                                  stroke-linecap="round" opacity="@(i == currentStrokeIndex ? 1.0 : 0.25)" />
                        }
                    </svg>
                </div>
            </div>
        }
        else
        {
            <div class="section">
                <h3 class="section-title">Thứ tự nét</h3>
                <p class="no-data-msg">Xem thứ tự nét tại <a href="https://jisho.org/search/@kanji.Kanji %23kanji" target="_blank" rel="noopener noreferrer">Jisho.org</a></p>
            </div>
        }

        <div class="nav-buttons">
            <FluentButton Appearance="@Appearance.Lightweight" OnClick="PrevKanji"
                         Disabled="@(!HasPrev)">
                ← Kanji trước
            </FluentButton>
            <FluentButton Appearance="@Appearance.Accent" OnClick="NextKanji"
                         Disabled="@(!HasNext)">
                Kanji sau →
            </FluentButton>
        </div>
    }
</div>

<style>
    .kanji-detail-container {
        max-width: 560px;
        margin: 0 auto;
    }
    .detail-header {
        margin-bottom: 16px;
    }
    .back-btn {
        font-size: 0.9rem;
    }
    .kanji-hero {
        text-align: center;
        padding: 20px 0;
    }
    .kanji-hero-char {
        font-size: 7rem;
        line-height: 1.1;
        font-family: var(--font-family);
        color: var(--text-primary);
        user-select: none;
    }
    .kanji-info-section {
        display: flex;
        flex-direction: column;
        gap: 8px;
        margin-bottom: 20px;
    }
    .info-row {
        display: flex;
        gap: 8px;
    }
    .info-card {
        flex: 1;
        background: var(--bg-card);
        border-radius: 12px;
        padding: 12px 16px;
        box-shadow: var(--shadow-sm);
        text-align: center;
    }
    .info-label {
        display: block;
        font-size: 0.7rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: var(--text-secondary);
        margin-bottom: 4px;
    }
    .info-value {
        font-size: 1.2rem;
        font-weight: 700;
        color: var(--text-primary);
    }
    .on-yomi { color: var(--color-on-yomi); }
    .kun-yomi { color: var(--color-kun-yomi); }
    .meaning { font-size: 1.1rem; }
    .stroke-count { font-size: 1.5rem; }
    .level-badge-detail {
        display: inline-block;
        padding: 4px 16px;
        border-radius: 20px;
        font-size: 0.9rem;
        font-weight: 700;
        background: var(--badge-level-bg, #c22b38);
        color: var(--badge-level-text, white);
    }
    .section {
        margin-bottom: 20px;
    }
    .section-title {
        font-size: 1rem;
        font-weight: 700;
        color: var(--text-primary);
        margin: 0 0 10px 0;
    }
    .examples-list {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }
    .example-item {
        background: var(--bg-card);
        border-radius: 10px;
        padding: 10px 14px;
        font-size: 0.95rem;
        color: var(--text-primary);
        box-shadow: var(--shadow-sm);
        font-family: var(--font-family);
    }
    .stroke-controls {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 12px;
        gap: 8px;
    }
    .stroke-indicator {
        font-size: 0.85rem;
        font-weight: 600;
        color: var(--text-secondary);
    }
    .stroke-svg-wrap {
        background: var(--bg-card);
        border-radius: 16px;
        padding: 20px;
        box-shadow: var(--shadow-sm);
        display: flex;
        justify-content: center;
    }
    .stroke-svg {
        width: 200px;
        height: 200px;
    }
    .no-data-msg {
        color: var(--text-secondary);
        font-size: 0.9rem;
    }
    .no-data-msg a {
        color: var(--accent-color, #c22b38);
    }
    .nav-buttons {
        display: flex;
        justify-content: space-between;
        gap: 8px;
        margin-top: 24px;
    }
</style>

@code {
    [Parameter]
    public int Id { get; set; }

    private JapaneseKanji? kanji;
    private List<JapaneseKanji> allKanji = new();
    private int currentStrokeIndex;
    private bool isLoading = true;

    private int CurrentIndex => allKanji.FindIndex(k => k.Id == Id);
    private bool HasPrev => CurrentIndex > 0;
    private bool HasNext => CurrentIndex >= 0 && CurrentIndex < allKanji.Count - 1;

    protected override async Task OnInitializedAsync()
    {
        allKanji = await KanjiService.GetAllAsync();
        kanji = allKanji.FirstOrDefault(k => k.Id == Id);
        if (kanji == null)
        {
            isLoading = false;
            return;
        }
        currentStrokeIndex = 0;
        isLoading = false;
    }

    private void PrevStroke()
    {
        if (currentStrokeIndex > 0)
            currentStrokeIndex--;
    }

    private void NextStroke()
    {
        if (kanji != null && currentStrokeIndex < kanji.Strokes.Count - 1)
            currentStrokeIndex++;
    }

    private async Task PrevKanji()
    {
        var idx = CurrentIndex;
        if (idx > 0)
        {
            var prev = allKanji[idx - 1];
            Navigation.NavigateTo($"/kanji/{prev.Id}");
        }
    }

    private async Task NextKanji()
    {
        var idx = CurrentIndex;
        if (idx >= 0 && idx < allKanji.Count - 1)
        {
            var next = allKanji[idx + 1];
            Navigation.NavigateTo($"/kanji/{next.Id}");
        }
    }
}
