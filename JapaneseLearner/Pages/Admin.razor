@code {
    private string activeTab = "chars";
    private string _notifMessage = "";
    private bool _showNotif;

    // Char state
    private List<JapaneseChar>? chars;
    private bool showCharDialog;
    private bool isEditCharMode;
    private JapaneseChar editingChar = new();
    private bool showCharDeleteConfirm;
    private JapaneseChar? charToDelete;

    // Word state
    private List<JapaneseWord>? words;
    private bool _isWordLoading;
    private int _wordLoadProgress;
    private bool showWordDialog;
    private bool isEditWordMode;
    private JapaneseWord editingWord = new();
    private bool showWordDeleteConfirm;
    private JapaneseWord? wordToDelete;

    // Grammar state
    private List<JapaneseGrammar>? grammarList;
    private bool _isGrammarLoading;
    private int _grammarLoadProgress;
    private bool showGrammarDialog;
    private bool isEditGrammarMode;
    private JapaneseGrammar editingGrammar = new();
    private string _grammarExamplesStr = "";
    private bool showGrammarDeleteConfirm;
    private JapaneseGrammar? grammarToDelete;

    // Kanji state
    private List<JapaneseKanji>? kanjiList;
    private bool _isKanjiLoading;
    private int _kanjiLoadProgress;
    private bool showKanjiDialog;
    private bool isEditKanjiMode;
    private JapaneseKanji editingKanji = new();
    private string _kanjiStrokeCountStr = "0";
    private bool showKanjiDeleteConfirm;
    private JapaneseKanji? kanjiToDelete;

    private CancellationTokenSource? _notifCts;

    private bool IsCharFormValid =>
        !string.IsNullOrWhiteSpace(editingChar.Character) &&
        !string.IsNullOrWhiteSpace(editingChar.Romaji);

    private bool IsWordFormValid =>
        !string.IsNullOrWhiteSpace(editingWord.Characters) &&
        !string.IsNullOrWhiteSpace(editingWord.Romaji) &&
        !string.IsNullOrWhiteSpace(editingWord.Meaning);

    private bool IsKanjiFormValid =>
        !string.IsNullOrWhiteSpace(editingKanji.Kanji) &&
        !string.IsNullOrWhiteSpace(editingKanji.OnYomi) &&
        !string.IsNullOrWhiteSpace(editingKanji.KunYomi) &&
        !string.IsNullOrWhiteSpace(editingKanji.Romaji) &&
        !string.IsNullOrWhiteSpace(editingKanji.Meaning);

    private bool IsGrammarFormValid =>
        !string.IsNullOrWhiteSpace(editingGrammar.Pattern) &&
        !string.IsNullOrWhiteSpace(editingGrammar.Meaning) &&
        !string.IsNullOrWhiteSpace(editingGrammar.Explanation);

    protected override async Task OnInitializedAsync()
    {
        await RefreshCharList();
    }

    private void SwitchToChars()
    {
        activeTab = "chars";
        if (chars == null || chars.Count == 0)
            _ = RefreshCharList();
    }

    private void SwitchToWords()
    {
        activeTab = "words";
        if (!_isWordLoading && (words == null || words.Count == 0))
            _ = RefreshWordList();
    }

    private void SwitchToKanji()
    {
        activeTab = "kanji";
        if (!_isKanjiLoading && (kanjiList == null || kanjiList.Count == 0))
            _ = RefreshKanjiList();
    }

    private void SwitchToGrammar()
    {
        activeTab = "grammar";
        if (!_isGrammarLoading && (grammarList == null || grammarList.Count == 0))
            _ = RefreshGrammarList();
    }

    private async Task ShowNotif(string message)
    {
        _notifCts?.Cancel();
        _notifCts = new CancellationTokenSource();

        _notifMessage = message;
        _showNotif = true;
        StateHasChanged();

        try
        {
            await Task.Delay(3000, _notifCts.Token);
            _showNotif = false;
        }
        catch (TaskCanceledException)
        {
            // A newer notification replaced this one
        }
    }

    // ===== Char CRUD =====
    private async Task RefreshCharList()
    {
        chars = await CharService.GetAllAsync();
    }

    private void OpenAddCharDialog()
    {
        editingChar = new JapaneseChar { Type = "Hiragana" };
        isEditCharMode = false;
        showCharDialog = true;
    }

    private void OpenEditCharDialog(JapaneseChar c)
    {
        editingChar = new JapaneseChar
        {
            Id = c.Id,
            Character = c.Character,
            Romaji = c.Romaji,
            Type = c.Type
        };
        isEditCharMode = true;
        showCharDialog = true;
    }

    private async Task SaveChar()
    {
        if (!IsCharFormValid) return;

        if (isEditCharMode)
            await CharService.UpdateAsync(editingChar);
        else
            await CharService.AddAsync(editingChar);

        showCharDialog = false;
        await RefreshCharList();
        await ShowNotif(isEditCharMode ? "Đã cập nhật chữ" : "Đã thêm chữ mới");
    }

    private void CancelCharDialog()
    {
        showCharDialog = false;
    }

    private void OpenDeleteCharConfirm(JapaneseChar c)
    {
        charToDelete = c;
        showCharDeleteConfirm = true;
    }

    private async Task DeleteChar()
    {
        if (charToDelete != null)
        {
            await CharService.DeleteAsync(charToDelete.Id);
            charToDelete = null;
        }
        showCharDeleteConfirm = false;
        await RefreshCharList();
    }

    private void CancelCharDelete()
    {
        showCharDeleteConfirm = false;
        charToDelete = null;
    }

    // ===== Word CRUD =====
    private async Task RefreshWordList()
    {
        _isWordLoading = true;
        _wordLoadProgress = 0;
        words = null;
        var progress = new Progress<int>(p =>
        {
            _wordLoadProgress = p;
            StateHasChanged();
        });
        words = await WordService.GetAllAsync(progress);
        _isWordLoading = false;
    }

    private void OpenAddWordDialog()
    {
        editingWord = new JapaneseWord { Type = "N5", Level = "N5" };
        isEditWordMode = false;
        showWordDialog = true;
    }

    private void OpenEditWordDialog(JapaneseWord w)
    {
        editingWord = new JapaneseWord
        {
            Id = w.Id,
            Characters = w.Characters,
            Romaji = w.Romaji,
            Meaning = w.Meaning,
            Type = w.Type,
            Level = w.Level
        };
        isEditWordMode = true;
        showWordDialog = true;
    }

    private async Task SaveWord()
    {
        if (!IsWordFormValid) return;

        if (isEditWordMode)
            await WordService.UpdateAsync(editingWord);
        else
            await WordService.AddAsync(editingWord);

        showWordDialog = false;
        await RefreshWordList();
        await ShowNotif(isEditWordMode ? "Đã cập nhật từ" : "Đã thêm từ mới");
    }

    private void CancelWordDialog()
    {
        showWordDialog = false;
    }

    private void OpenDeleteWordConfirm(JapaneseWord w)
    {
        wordToDelete = w;
        showWordDeleteConfirm = true;
    }

    private async Task DeleteWord()
    {
        if (wordToDelete != null)
        {
            await WordService.DeleteAsync(wordToDelete.Id);
            wordToDelete = null;
        }
        showWordDeleteConfirm = false;
        await RefreshWordList();
        await ShowNotif("Đã xóa từ");
    }

    private void CancelWordDelete()
    {
        showWordDeleteConfirm = false;
        wordToDelete = null;
    }

    // ===== Grammar CRUD =====
    private async Task RefreshGrammarList()
    {
        _isGrammarLoading = true;
        _grammarLoadProgress = 0;
        grammarList = null;
        var progress = new Progress<int>(p =>
        {
            _grammarLoadProgress = p;
            StateHasChanged();
        });
        grammarList = await GrammarService.GetAllAsync(progress);
        _isGrammarLoading = false;
    }

    private void OpenAddGrammarDialog()
    {
        editingGrammar = new JapaneseGrammar { JLPTLevel = "N5" };
        _grammarExamplesStr = "";
        isEditGrammarMode = false;
        showGrammarDialog = true;
    }

    private void OpenEditGrammarDialog(JapaneseGrammar g)
    {
        editingGrammar = new JapaneseGrammar
        {
            Id = g.Id,
            Pattern = g.Pattern,
            Meaning = g.Meaning,
            Explanation = g.Explanation,
            JLPTLevel = g.JLPTLevel,
            Examples = g.Examples
        };
        _grammarExamplesStr = string.Join("\n", g.Examples);
        isEditGrammarMode = true;
        showGrammarDialog = true;
    }

    private async Task SaveGrammar()
    {
        if (!IsGrammarFormValid) return;

        editingGrammar.Examples = _grammarExamplesStr
            .Split('\n', StringSplitOptions.RemoveEmptyEntries)
            .Select(l => l.Trim())
            .Where(l => !string.IsNullOrEmpty(l))
            .ToList();

        if (isEditGrammarMode)
            await GrammarService.UpdateAsync(editingGrammar);
        else
            await GrammarService.AddAsync(editingGrammar);

        showGrammarDialog = false;
        await RefreshGrammarList();
        await ShowNotif(isEditGrammarMode ? "Đã cập nhật mẫu ngữ pháp" : "Đã thêm mẫu ngữ pháp mới");
    }

    private void CancelGrammarDialog()
    {
        showGrammarDialog = false;
    }

    private void OpenDeleteGrammarConfirm(JapaneseGrammar g)
    {
        grammarToDelete = g;
        showGrammarDeleteConfirm = true;
    }

    private async Task DeleteGrammar()
    {
        if (grammarToDelete != null)
        {
            await GrammarService.DeleteAsync(grammarToDelete.Id);
            grammarToDelete = null;
        }
        showGrammarDeleteConfirm = false;
        await RefreshGrammarList();
        await ShowNotif("Đã xóa mẫu ngữ pháp");
    }

    private void CancelGrammarDelete()
    {
        showGrammarDeleteConfirm = false;
        grammarToDelete = null;
    }

    // ===== Kanji CRUD =====
    private async Task RefreshKanjiList()
    {
        _isKanjiLoading = true;
        _kanjiLoadProgress = 0;
        kanjiList = null;
        var progress = new Progress<int>(p =>
        {
            _kanjiLoadProgress = p;
            StateHasChanged();
        });
        kanjiList = await KanjiService.GetAllAsync(progress);
        _isKanjiLoading = false;
    }

    private void OpenAddKanjiDialog()
    {
        editingKanji = new JapaneseKanji { JLPTLevel = "N5" };
        _kanjiStrokeCountStr = "0";
        isEditKanjiMode = false;
        showKanjiDialog = true;
    }

    private void OpenEditKanjiDialog(JapaneseKanji k)
    {
        editingKanji = new JapaneseKanji
        {
            Id = k.Id,
            Kanji = k.Kanji,
            OnYomi = k.OnYomi,
            KunYomi = k.KunYomi,
            Meaning = k.Meaning,
            StrokeCount = k.StrokeCount,
            JLPTLevel = k.JLPTLevel,
            Examples = k.Examples,
            Strokes = k.Strokes
        };
        _kanjiStrokeCountStr = k.StrokeCount.ToString();
        isEditKanjiMode = true;
        showKanjiDialog = true;
    }

    private async Task SaveKanji()
    {
        if (!IsKanjiFormValid) return;

        int.TryParse(_kanjiStrokeCountStr, out var strokes);
        editingKanji.StrokeCount = strokes;

        if (isEditKanjiMode)
            await KanjiService.UpdateAsync(editingKanji);
        else
            await KanjiService.AddAsync(editingKanji);

        showKanjiDialog = false;
        await RefreshKanjiList();
        await ShowNotif(isEditKanjiMode ? "Đã cập nhật Kanji" : "Đã thêm Kanji mới");
    }

    private void CancelKanjiDialog()
    {
        showKanjiDialog = false;
    }

    private void OpenDeleteKanjiConfirm(JapaneseKanji k)
    {
        kanjiToDelete = k;
        showKanjiDeleteConfirm = true;
    }

    private async Task DeleteKanji()
    {
        if (kanjiToDelete != null)
        {
            await KanjiService.DeleteAsync(kanjiToDelete.Id);
            kanjiToDelete = null;
        }
        showKanjiDeleteConfirm = false;
        await RefreshKanjiList();
        await ShowNotif("Đã xóa Kanji");
    }

    private void CancelKanjiDelete()
    {
        showKanjiDeleteConfirm = false;
        kanjiToDelete = null;
    }

    private string GetTypeLabel(string? type)
    {
        return type switch
        {
            "Seion" => "清音",
            "Dakuon" => "濁音",
            "Handakuon" => "半濁音",
            "Yoon" => "拗音",
            "Sokuon" => "促音",
            "Choon" => "長音",
            "N5" => "N5",
            _ => type ?? ""
        };
    }
