@page "/admin"
@inject ICharService CharService
@inject IWordService WordService
@inject IKanjiService KanjiService
@inject IGrammarService GrammarService

<PageTitle>Quản lý - Japanese Learner</PageTitle>

<div class="admin-container">
    <div class="admin-tab-bar">
        <FluentButton Appearance="@(activeTab == "chars" ? Appearance.Accent : Appearance.Neutral)" Class="admin-tab-btn" @onclick="SwitchToChars">
            <FluentIcon Icon="@(Icons.Regular.Size20.BookContacts)" /> Bảng chữ cái
        </FluentButton>
        <FluentButton Appearance="@(activeTab == "words" ? Appearance.Accent : Appearance.Neutral)" Class="admin-tab-btn" @onclick="SwitchToWords">
            <FluentIcon Icon="@(Icons.Regular.Size20.Document)" /> Từ vựng
        </FluentButton>
        <FluentButton Appearance="@(activeTab == "kanji" ? Appearance.Accent : Appearance.Neutral)" Class="admin-tab-btn" @onclick="SwitchToKanji">
            <FluentIcon Icon="@(Icons.Regular.Size20.Compose)" /> Kanji
        </FluentButton>
        <FluentButton Appearance="@(activeTab == "grammar" ? Appearance.Accent : Appearance.Neutral)" Class="admin-tab-btn" @onclick="SwitchToGrammar">
            <FluentIcon Icon="@(Icons.Regular.Size20.TextGrammarWand)" /> Ngữ pháp
        </FluentButton>
    </div>

    @if (_showNotif)
    {
        <div class="notif-bar notif-success">@_notifMessage</div>
    }

    @if (activeTab == "chars")
    {
            <div class="admin-header">
            <div class="admin-header-left">
                <div class="admin-icon"><FluentIcon Icon="@(Icons.Regular.Size20.BookContacts)" /></div>
                <div>
                    <h2>Quản lý bảng chữ cái</h2>
                    <p class="admin-sub">Thêm, sửa, xóa các ký tự Hiragana và Katakana</p>
                </div>
            </div>
            <FluentButton Appearance="@Appearance.Accent" OnClick="OpenAddCharDialog" Class="add-btn">
                <FluentIcon Icon="@(Icons.Regular.Size20.Add)" /> Thêm chữ
            </FluentButton>
        </div>

        @if (chars == null)
        {
            <div class="loading-wrap">
                <FluentProgressRing />
            </div>
        }
        else if (chars.Count == 0)
        {
            <div class="empty-state">
                <div class="empty-icon"><FluentIcon Icon="@(Icons.Regular.Size20.BookContacts)" /></div>
                <h3>Danh sách trống</h3>
                <p>Chưa có chữ cái nào. Hãy thêm chữ mới để bắt đầu.</p>
            </div>
        }
        else
        {
            <div class="table-wrap">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Chữ</th>
                            <th>Phiên âm</th>
                            <th>Loại</th>
                            <th>Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in chars)
                        {
                            <tr>
                                <td><span class="table-char">@c.Character</span></td>
                                <td><code class="table-romaji">@c.Romaji</code></td>
                                <td>
                                    <span class="type-badge @(c.Type == "Hiragana" ? "type-hira" : "type-kata")">
                                        @c.Type
                                    </span>
                                </td>
                                <td>
                                    <div class="action-btns">
                                        <FluentButton Appearance="@Appearance.Lightweight" OnClick="() => OpenEditCharDialog(c)" Class="action-btn-icon" Title="@("Sửa chữ " + c.Character)" aria-label="@("Sửa chữ " + c.Character)">
                                            <FluentIcon Icon="@(Icons.Regular.Size20.Edit)" />
                                        </FluentButton>
                                        <FluentButton Appearance="@Appearance.Lightweight" OnClick="() => OpenDeleteCharConfirm(c)" Class="action-btn-icon" Title="@("Xóa chữ " + c.Character)" aria-label="@("Xóa chữ " + c.Character)">
                                            <FluentIcon Icon="@(Icons.Regular.Size20.Delete)" />
                                        </FluentButton>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        @if (showCharDialog)
        {
            <FluentDialog Open="true">
                <h3>@(isEditCharMode ? "Sửa chữ" : "Thêm chữ mới")</h3>
                <div class="dialog-fields">
                    <FluentTextField @bind-Value="editingChar.Character" Label="Chữ Nhật" Required="true" />
                    <FluentTextField @bind-Value="editingChar.Romaji" Label="Phiên âm (Romaji)" Required="true" />
                    <FluentSelect TOption="string" @bind-Value="editingChar.Type" Label="Loại" Required="true">
                        <FluentOption TOption="string" Value="@("Hiragana")">Hiragana</FluentOption>
                        <FluentOption TOption="string" Value="@("Katakana")">Katakana</FluentOption>
                    </FluentSelect>
                </div>
                <div class="dialog-actions">
                    <FluentButton Appearance="@Appearance.Neutral" OnClick="CancelCharDialog">Hủy</FluentButton>
                    <FluentButton Appearance="@Appearance.Accent" OnClick="SaveChar" Disabled="!IsCharFormValid">
                        @(isEditCharMode ? "Lưu thay đổi" : "Thêm vào danh sách")
                    </FluentButton>
                </div>
            </FluentDialog>
        }

        @if (showCharDeleteConfirm)
        {
            <FluentDialog Open="true">
                <h3>Xác nhận xóa</h3>
                <p>Bạn có chắc muốn xóa chữ <strong>@charToDelete?.Character</strong> (@charToDelete?.Romaji)?</p>
                <div class="dialog-actions">
                    <FluentButton Appearance="@Appearance.Neutral" OnClick="CancelCharDelete">Hủy</FluentButton>
                    <FluentButton Appearance="@Appearance.Accent" OnClick="DeleteChar">Xóa</FluentButton>
                </div>
            </FluentDialog>
        }
    }

    @if (activeTab == "words")
    {
        <div class="admin-header">
            <div class="admin-header-left">
                <div class="admin-icon word-icon"><FluentIcon Icon="@(Icons.Regular.Size20.Document)" /></div>
                <div>
                    <h2>Quản lý từ vựng</h2>
                    <p class="admin-sub">Thêm, sửa, xóa từ vựng tiếng Nhật</p>
                </div>
            </div>
            <FluentButton Appearance="@Appearance.Accent" OnClick="OpenAddWordDialog" Class="add-btn">
                <FluentIcon Icon="@(Icons.Regular.Size20.Add)" /> Thêm từ
            </FluentButton>
        </div>

        @if (words == null)
        {
            <div class="loading-wrap">
                <FluentProgressRing />
                <div class="loading-text">Đang tải từ vựng... @_wordLoadProgress%</div>
            </div>
        }
        else if (words.Count == 0)
        {
            <div class="empty-state">
                <div class="empty-icon"><FluentIcon Icon="@(Icons.Regular.Size20.Document)" /></div>
                <h3>Danh sách trống</h3>
                <p>Chưa có từ vựng nào. Hãy thêm từ mới để bắt đầu.</p>
            </div>
        }
        else
        {
            <div class="word-count">Tổng số: <strong>@words.Count</strong> từ</div>
            <div class="table-wrap">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Từ</th>
                            <th>Phiên âm</th>
                            <th>Nghĩa</th>
                            <th>Loại âm</th>
                            <th>Level</th>
                            <th>Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var w in words)
                        {
                            <tr>
                                <td><span class="table-char">@w.Characters</span></td>
                                <td><code class="table-romaji">@w.Romaji</code></td>
                                <td><span class="table-meaning">@w.Meaning</span></td>
                                <td><span class="type-badge type-@w.Type?.ToLowerInvariant()">@GetTypeLabel(w.Type)</span></td>
                                <td><span class="level-badge">@w.Level</span></td>
                                <td>
                                    <div class="action-btns">
                                        <FluentButton Appearance="@Appearance.Lightweight" OnClick="() => OpenEditWordDialog(w)" Class="action-btn-icon" Title="@("Sửa từ " + w.Characters)" aria-label="@("Sửa từ " + w.Characters)">
                                            <FluentIcon Icon="@(Icons.Regular.Size20.Edit)" />
                                        </FluentButton>
                                        <FluentButton Appearance="@Appearance.Lightweight" OnClick="() => OpenDeleteWordConfirm(w)" Class="action-btn-icon" Title="@("Xóa từ " + w.Characters)" aria-label="@("Xóa từ " + w.Characters)">
                                            <FluentIcon Icon="@(Icons.Regular.Size20.Delete)" />
                                        </FluentButton>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        @if (showWordDialog)
        {
            <FluentDialog Open="true">
                <h3>@(isEditWordMode ? "Sửa từ" : "Thêm từ mới")</h3>
                <div class="dialog-fields">
                    <FluentTextField @bind-Value="editingWord.Characters" Label="Chữ Nhật" Required="true" />
                    <FluentTextField @bind-Value="editingWord.Romaji" Label="Phiên âm (Romaji)" Required="true" />
                    <FluentTextField @bind-Value="editingWord.Meaning" Label="Nghĩa" Required="true" />
                    <FluentSelect TOption="string" @bind-Value="editingWord.Type" Label="Loại âm" Required="true">
                        <FluentOption TOption="string" Value="@("N5")">N5 (Tổng hợp)</FluentOption>
                        <FluentOption TOption="string" Value="@("Seion")">清音 (Âm cơ bản)</FluentOption>
                        <FluentOption TOption="string" Value="@("Dakuon")">濁音 (Âm đục)</FluentOption>
                        <FluentOption TOption="string" Value="@("Handakuon")">半濁音 (Âm bán đục)</FluentOption>
                        <FluentOption TOption="string" Value="@("Yoon")">拗音 (Âm ghép)</FluentOption>
                        <FluentOption TOption="string" Value="@("Sokuon")">促音 (Âm ngắt)</FluentOption>
                        <FluentOption TOption="string" Value="@("Choon")">長音 (Âm dài)</FluentOption>
                    </FluentSelect>
                    <FluentSelect TOption="string" @bind-Value="editingWord.Level" Label="JLPT Level" Required="true">
                        <FluentOption TOption="string" Value="@("N5")">N5</FluentOption>
                        <FluentOption TOption="string" Value="@("N4")">N4</FluentOption>
                        <FluentOption TOption="string" Value="@("N3")">N3</FluentOption>
                        <FluentOption TOption="string" Value="@("N2")">N2</FluentOption>
                        <FluentOption TOption="string" Value="@("N1")">N1</FluentOption>
                    </FluentSelect>
                </div>
                <div class="dialog-actions">
                    <FluentButton Appearance="@Appearance.Neutral" OnClick="CancelWordDialog">Hủy</FluentButton>
                    <FluentButton Appearance="@Appearance.Accent" OnClick="SaveWord" Disabled="!IsWordFormValid">
                        @(isEditWordMode ? "Lưu thay đổi" : "Thêm vào danh sách")
                    </FluentButton>
                </div>
            </FluentDialog>
        }

        @if (showWordDeleteConfirm)
        {
            <FluentDialog Open="true">
                <h3>Xác nhận xóa</h3>
                <p>Bạn có chắc muốn xóa từ <strong>@wordToDelete?.Characters</strong> (@wordToDelete?.Romaji)?</p>
                <div class="dialog-actions">
                    <FluentButton Appearance="@Appearance.Neutral" OnClick="CancelWordDelete">Hủy</FluentButton>
                    <FluentButton Appearance="@Appearance.Accent" OnClick="DeleteWord">Xóa</FluentButton>
                </div>
            </FluentDialog>
        }
    }

    @if (activeTab == "grammar")
    {
        <div class="admin-header">
            <div class="admin-header-left">
                <div class="admin-icon grammar-admin-icon"><FluentIcon Icon="@(Icons.Regular.Size20.TextGrammarWand)" /></div>
                <div>
                    <h2>Quản lý ngữ pháp</h2>
                    <p class="admin-sub">Thêm, sửa, xóa các mẫu ngữ pháp N5</p>
                </div>
            </div>
            <FluentButton Appearance="@Appearance.Accent" OnClick="OpenAddGrammarDialog" Class="add-btn">
                <FluentIcon Icon="@(Icons.Regular.Size20.Add)" /> Thêm ngữ pháp
            </FluentButton>
        </div>

        @if (grammarList == null)
        {
            <div class="loading-wrap">
                <FluentProgressRing />
                <div class="loading-text">Đang tải ngữ pháp... @_grammarLoadProgress%</div>
            </div>
        }
        else if (grammarList.Count == 0)
        {
            <div class="empty-state">
                <div class="empty-icon"><FluentIcon Icon="@(Icons.Regular.Size20.TextGrammarWand)" /></div>
                <h3>Danh sách trống</h3>
                <p>Chưa có mẫu ngữ pháp nào. Hãy thêm mới để bắt đầu.</p>
            </div>
        }
        else
        {
            <div class="word-count">Tổng số: <strong>@grammarList.Count</strong> mẫu ngữ pháp</div>
            <div class="table-wrap">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Mẫu</th>
                            <th>Nghĩa</th>
                            <th>Level</th>
                            <th>Ví dụ</th>
                            <th>Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var g in grammarList)
                        {
                            <tr>
                                <td><span class="table-char">@g.Pattern</span></td>
                                <td><span class="table-meaning">@g.Meaning</span></td>
                                <td><span class="level-badge">@g.JLPTLevel</span></td>
                                <td>@g.Examples.Count</td>
                                <td>
                                    <div class="action-btns">
                                        <FluentButton Appearance="@Appearance.Lightweight" OnClick="() => OpenEditGrammarDialog(g)" Class="action-btn-icon" Title="@("Sửa mẫu " + g.Pattern)" aria-label="@("Sửa mẫu " + g.Pattern)">
                                            <FluentIcon Icon="@(Icons.Regular.Size20.Edit)" />
                                        </FluentButton>
                                        <FluentButton Appearance="@Appearance.Lightweight" OnClick="() => OpenDeleteGrammarConfirm(g)" Class="action-btn-icon" Title="@("Xóa mẫu " + g.Pattern)" aria-label="@("Xóa mẫu " + g.Pattern)">
                                            <FluentIcon Icon="@(Icons.Regular.Size20.Delete)" />
                                        </FluentButton>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        @if (showGrammarDialog)
        {
            <FluentDialog Open="true">
                <h3>@(isEditGrammarMode ? "Sửa mẫu ngữ pháp" : "Thêm mẫu ngữ pháp mới")</h3>
                <div class="dialog-fields">
                    <FluentTextField @bind-Value="editingGrammar.Pattern" Label="Mẫu ngữ pháp" Required="true" />
                    <FluentTextField @bind-Value="editingGrammar.Meaning" Label="Nghĩa" Required="true" />
                    <FluentTextField @bind-Value="editingGrammar.Explanation" Label="Giải thích" Required="true" />
                    <FluentSelect TOption="string" @bind-Value="editingGrammar.JLPTLevel" Label="JLPT Level" Required="true">
                        <FluentOption TOption="string" Value="@("N5")">N5</FluentOption>
                        <FluentOption TOption="string" Value="@("N4")">N4</FluentOption>
                        <FluentOption TOption="string" Value="@("N3")">N3</FluentOption>
                        <FluentOption TOption="string" Value="@("N2")">N2</FluentOption>
                        <FluentOption TOption="string" Value="@("N1")">N1</FluentOption>
                    </FluentSelect>
                    <FluentTextField @bind-Value="_grammarExamplesStr" Label="Ví dụ (mỗi dòng một ví dụ)" Multiline="true" />
                </div>
                <div class="dialog-actions">
                    <FluentButton Appearance="@Appearance.Neutral" OnClick="CancelGrammarDialog">Hủy</FluentButton>
                    <FluentButton Appearance="@Appearance.Accent" OnClick="SaveGrammar" Disabled="!IsGrammarFormValid">
                        @(isEditGrammarMode ? "Lưu thay đổi" : "Thêm vào danh sách")
                    </FluentButton>
                </div>
            </FluentDialog>
        }

        @if (showGrammarDeleteConfirm)
        {
            <FluentDialog Open="true">
                <h3>Xác nhận xóa</h3>
                <p>Bạn có chắc muốn xóa mẫu ngữ pháp <strong>@grammarToDelete?.Pattern</strong> (@grammarToDelete?.Meaning)?</p>
                <div class="dialog-actions">
                    <FluentButton Appearance="@Appearance.Neutral" OnClick="CancelGrammarDelete">Hủy</FluentButton>
                    <FluentButton Appearance="@Appearance.Accent" OnClick="DeleteGrammar">Xóa</FluentButton>
                </div>
            </FluentDialog>
        }
    }

    @if (activeTab == "kanji")
    {
        <div class="admin-header">
            <div class="admin-header-left">
                <div class="admin-icon kanji-admin-icon"><FluentIcon Icon="@(Icons.Regular.Size20.Compose)" /></div>
                <div>
                    <h2>Quản lý Kanji</h2>
                    <p class="admin-sub">Thêm, sửa, xóa Kanji N5</p>
                </div>
            </div>
            <FluentButton Appearance="@Appearance.Accent" OnClick="OpenAddKanjiDialog" Class="add-btn">
                <FluentIcon Icon="@(Icons.Regular.Size20.Add)" /> Thêm Kanji
            </FluentButton>
        </div>

        @if (kanjiList == null)
        {
            <div class="loading-wrap">
                <FluentProgressRing />
                <div class="loading-text">Đang tải Kanji... @_kanjiLoadProgress%</div>
            </div>
        }
        else if (kanjiList.Count == 0)
        {
            <div class="empty-state">
                <div class="empty-icon"><FluentIcon Icon="@(Icons.Regular.Size20.Compose)" /></div>
                <h3>Danh sách trống</h3>
                <p>Chưa có Kanji nào. Hãy thêm Kanji mới để bắt đầu.</p>
            </div>
        }
        else
        {
            <div class="word-count">Tổng số: <strong>@kanjiList.Count</strong> Kanji</div>
            <div class="table-wrap">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Kanji</th>
                            <th>Âm On</th>
                            <th>Âm Kun</th>
                            <th>Romaji</th>
                            <th>Nghĩa</th>
                            <th>Nét</th>
                            <th>Level</th>
                            <th>Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var k in kanjiList)
                        {
                            <tr>
                                <td><span class="table-char">@k.Kanji</span></td>
                                <td><code class="table-romaji">@k.OnYomi</code></td>
                                <td><code class="table-romaji">@k.KunYomi</code></td>
                                <td><code class="table-romaji">@k.Romaji</code></td>
                                <td><span class="table-meaning">@k.Meaning</span></td>
                                <td>@k.StrokeCount</td>
                                <td><span class="level-badge">@k.JLPTLevel</span></td>
                                <td>
                                    <div class="action-btns">
                                        <FluentButton Appearance="@Appearance.Lightweight" OnClick="() => OpenEditKanjiDialog(k)" Class="action-btn-icon" Title="@("Sửa Kanji " + k.Kanji)" aria-label="@("Sửa Kanji " + k.Kanji)">
                                            <FluentIcon Icon="@(Icons.Regular.Size20.Edit)" />
                                        </FluentButton>
                                        <FluentButton Appearance="@Appearance.Lightweight" OnClick="() => OpenDeleteKanjiConfirm(k)" Class="action-btn-icon" Title="@("Xóa Kanji " + k.Kanji)" aria-label="@("Xóa Kanji " + k.Kanji)">
                                            <FluentIcon Icon="@(Icons.Regular.Size20.Delete)" />
                                        </FluentButton>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        @if (showKanjiDialog)
        {
            <FluentDialog Open="true">
                <h3>@(isEditKanjiMode ? "Sửa Kanji" : "Thêm Kanji mới")</h3>
                <div class="dialog-fields">
                    <FluentTextField @bind-Value="editingKanji.Kanji" Label="Kanji" Required="true" />
                    <FluentTextField @bind-Value="editingKanji.OnYomi" Label="Âm On" Required="true" />
                    <FluentTextField @bind-Value="editingKanji.KunYomi" Label="Âm Kun" Required="true" />
                    <FluentTextField @bind-Value="editingKanji.Romaji" Label="Romaji" Required="true" />
                    <FluentTextField @bind-Value="editingKanji.Meaning" Label="Nghĩa" Required="true" />
                    <FluentTextField @bind-Value="_kanjiStrokeCountStr" Label="Số nét" Type="number" />
                    <FluentSelect TOption="string" @bind-Value="editingKanji.JLPTLevel" Label="JLPT Level" Required="true">
                        <FluentOption TOption="string" Value="@("N5")">N5</FluentOption>
                        <FluentOption TOption="string" Value="@("N4")">N4</FluentOption>
                        <FluentOption TOption="string" Value="@("N3")">N3</FluentOption>
                        <FluentOption TOption="string" Value="@("N2")">N2</FluentOption>
                        <FluentOption TOption="string" Value="@("N1")">N1</FluentOption>
                    </FluentSelect>
                </div>
                <div class="dialog-actions">
                    <FluentButton Appearance="@Appearance.Neutral" OnClick="CancelKanjiDialog">Hủy</FluentButton>
                    <FluentButton Appearance="@Appearance.Accent" OnClick="SaveKanji" Disabled="!IsKanjiFormValid">
                        @(isEditKanjiMode ? "Lưu thay đổi" : "Thêm vào danh sách")
                    </FluentButton>
                </div>
            </FluentDialog>
        }

        @if (showKanjiDeleteConfirm)
        {
            <FluentDialog Open="true">
                <h3>Xác nhận xóa</h3>
                <p>Bạn có chắc muốn xóa Kanji <strong>@kanjiToDelete?.Kanji</strong> (@kanjiToDelete?.Meaning)?</p>
                <div class="dialog-actions">
                    <FluentButton Appearance="@Appearance.Neutral" OnClick="CancelKanjiDelete">Hủy</FluentButton>
                    <FluentButton Appearance="@Appearance.Accent" OnClick="DeleteKanji">Xóa</FluentButton>
                </div>
            </FluentDialog>
        }
    }
</div>

<style>
    .admin-container {
        max-width: 800px;
        margin: 0 auto;
    }
    .notif-bar {
        padding: 10px 16px;
        border-radius: 10px;
        margin-bottom: 12px;
        font-weight: 500;
        animation: feedbackFadeIn 0.2s ease;
    }
    .notif-success {
        background: var(--notif-success-bg);
        color: var(--notif-success-text);
        border: 1px solid var(--notif-success-border);
    }
    .admin-tab-bar {
        display: flex;
        gap: 6px;
        margin-bottom: 20px;
        background: var(--tab-bar-bg);
        border-radius: 14px;
        padding: 6px;
        box-shadow: var(--shadow-sm);
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        flex-wrap: nowrap;
    }
    .admin-tab-btn {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 10px 16px;
        border-radius: 10px;
        font-size: 0.9rem;
        font-weight: 600;
    }
    .admin-tab-btn::part(content) {
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }
    .admin-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 16px;
        flex-wrap: wrap;
        gap: 12px;
    }
    .admin-header-left {
        display: flex;
        align-items: center;
        gap: 14px;
    }
    .admin-icon {
        width: 44px;
        height: 44px;
