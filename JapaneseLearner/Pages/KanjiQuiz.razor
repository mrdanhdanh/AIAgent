    private List<KanjiVocabItem> availableVocab = new();
    private KanjiVocabItem? currentVocab;
    private List<AnswerOption> options = new();
    private AnswerOption? selectedOption;
    private bool? isCorrect;
    private int correctCount;
    private int wrongCount;
    private bool isKanjiToRomajiMode = true;
    private static readonly Random _rng = Random.Shared;
    private CancellationTokenSource? _timerCts;

    protected override void OnInitialized()
    {
        availableVocab = _vocabList.ToList();
        PickRandomKanji();
    }

    private void PickRandomKanji()
    {
        if (availableVocab.Count == 0) return;

        currentVocab = availableVocab[_rng.Next(availableVocab.Count)];
        selectedOption = null;
        isCorrect = null;

        options = GenerateOptions(currentVocab);
    }

    private List<AnswerOption> GenerateOptions(KanjiVocabItem correct)
    {
        if (isKanjiToRomajiMode)
        {
            var pool = availableVocab
                .Where(k => k.Romaji != correct.Romaji)
                .Select(k => k.Romaji)
                .Distinct()
                .ToList();

            var distractors = new List<string>();
            while (distractors.Count < 3 && pool.Count > 0)
            {
                var idx = _rng.Next(pool.Count);
                distractors.Add(pool[idx]);
                pool.RemoveAt(idx);
            }
            while (distractors.Count < 3)
            {
                distractors.Add("???");
            }

            var result = new List<AnswerOption>
            {
                new AnswerOption { Display = correct.Romaji, IsCorrect = true }
            };
            result.AddRange(distractors.Select(d => new AnswerOption { Display = d, IsCorrect = false }));
            Shuffle(result);
            return result;
        }
        else
        {
            var pool = availableVocab
                .Where(k => k.Word != correct.Word)
                .Select(k => k.Word)
                .Distinct()
                .ToList();

            var distractors = new List<string>();
            while (distractors.Count < 3 && pool.Count > 0)
            {
                var idx = _rng.Next(pool.Count);
                distractors.Add(pool[idx]);
                pool.RemoveAt(idx);
            }
            while (distractors.Count < 3)
            {
                distractors.Add("???");
            }

            var result = new List<AnswerOption>
            {
                new AnswerOption { Display = correct.Word, IsCorrect = true }
            };
            result.AddRange(distractors.Select(d => new AnswerOption { Display = d, IsCorrect = false }));
            Shuffle(result);
            return result;
        }
    }

    private static void Shuffle<T>(List<T> list)
    {
        for (int i = list.Count - 1; i > 0; i--)
        {
            int j = _rng.Next(i + 1);
            (list[i], list[j]) = (list[j], list[i]);
        }
    }

    private async Task SelectAnswer(AnswerOption opt)
    {
        if (selectedOption != null) return;

        selectedOption = opt;
        isCorrect = opt.IsCorrect;

        if (opt.IsCorrect)
            correctCount++;
        else
            wrongCount++;

        _timerCts?.Cancel();
        _timerCts = new CancellationTokenSource();
        try
        {
            await Task.Delay(3000, _timerCts.Token);
            PickRandomKanji();
            StateHasChanged();
        }
        catch (TaskCanceledException)
        {
        }
    }

    private void SwitchMode(bool toKanjiToRomaji)
    {
        if (isKanjiToRomajiMode == toKanjiToRomaji) return;
        isKanjiToRomajiMode = toKanjiToRomaji;
        _timerCts?.Cancel();
        PickRandomKanji();
        StateHasChanged();
    }
}
