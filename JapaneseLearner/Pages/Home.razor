@page "/"
@inject NavigationManager Nav

<PageTitle>Japanese Learner — Học tiếng Nhật</PageTitle>

<div class="home-container">
    <section class="home-hero">
        <div class="hero-copy">
            <p class="hero-kicker">Hiragana · Katakana · Kanji · JLPT N5</p>
            <h1 class="hero-title">
                Japanese Learner<span class="hero-dot">.</span>
            </h1>
            <p class="hero-subtitle">
                Ứng dụng học tiếng Nhật toàn diện — từ bảng chữ cái, từ vựng đến Kanji và ngữ pháp.
                Luyện tập mỗi ngày để tiến bộ nhanh hơn.
            </p>
            <div class="hero-cta">
                <FluentButton Appearance="@Appearance.Accent" Class="cta-primary" @onclick="@(() => Nav.NavigateTo("/alphabet"))">
                    Bắt đầu học
                </FluentButton>
                <FluentButton Appearance="@Appearance.Lightweight" Class="cta-secondary" @onclick="@(() => Nav.NavigateTo("/words/quiz"))">
                    Thử trắc nghiệm →
                </FluentButton>
            </div>
        </div>
        <div class="hero-glyph" aria-hidden="true">学</div>
    </section>

    <div class="nav-grid">
        <div class="nav-card featured" data-color="alphabet">
            <div class="nav-card-icon" aria-hidden="true">
                <FluentIcon Icon="@(Icons.Regular.Size28.BookContacts)" />
            </div>
            <div class="nav-card-body">
                <h2 class="nav-card-title">Bảng chữ cái</h2>
                <p class="nav-card-desc">Học Hiragana và Katakana qua flashcard. Luyện gõ Romaji để ghi nhớ mặt chữ.</p>
            </div>
            <FluentButton Appearance="@Appearance.Accent" Class="nav-card-btn" @onclick="@(() => Nav.NavigateTo("/alphabet"))">
                Bắt đầu
            </FluentButton>
        </div>

        <div class="nav-card" data-color="words">
            <div class="nav-card-icon" aria-hidden="true">
                <FluentIcon Icon="@(Icons.Regular.Size24.Document)" />
            </div>
            <div class="nav-card-body">
                <h2 class="nav-card-title">Từ vựng</h2>
                <p class="nav-card-desc">Học từ vựng theo chủ đề với flashcard và phiên âm chi tiết.</p>
            </div>
            <FluentButton Appearance="@Appearance.Lightweight" Class="nav-card-btn" @onclick="@(() => Nav.NavigateTo("/words"))">
                Mở →
            </FluentButton>
        </div>

        <div class="nav-card" data-color="practice">
            <div class="nav-card-icon" aria-hidden="true">
                <FluentIcon Icon="@(Icons.Regular.Size24.Compose)" />
            </div>
            <div class="nav-card-body">
                <h2 class="nav-card-title">Luyện viết</h2>
                <p class="nav-card-desc">Luyện viết tay trên canvas, nhận diện chữ bạn đã vẽ.</p>
            </div>
            <FluentButton Appearance="@Appearance.Lightweight" Class="nav-card-btn" @onclick="@(() => Nav.NavigateTo("/practice"))">
                Mở →
            </FluentButton>
        </div>

        <div class="nav-card" data-color="quiz">
            <div class="nav-card-icon" aria-hidden="true">
                <FluentIcon Icon="@(Icons.Regular.Size24.Target)" />
            </div>
            <div class="nav-card-body">
                <h2 class="nav-card-title">Quiz từ vựng</h2>
                <p class="nav-card-desc">Trắc nghiệm nhiều lựa chọn để củng cố vốn từ đã học.</p>
            </div>
            <FluentButton Appearance="@Appearance.Lightweight" Class="nav-card-btn" @onclick="@(() => Nav.NavigateTo("/words/quiz"))">
                Mở →
            </FluentButton>
        </div>

        <div class="nav-card" data-color="kanji">
            <div class="nav-card-icon" aria-hidden="true">
                <FluentIcon Icon="@(Icons.Regular.Size24.Compose)" />
            </div>
            <div class="nav-card-body">
                <h2 class="nav-card-title">Kanji</h2>
                <p class="nav-card-desc">Tra cứu và học chữ Kanji với âm On, âm Kun và ví dụ minh họa.</p>
            </div>
            <FluentButton Appearance="@Appearance.Lightweight" Class="nav-card-btn" @onclick="@(() => Nav.NavigateTo("/kanji"))">
                Mở →
            </FluentButton>
        </div>

        <div class="nav-card" data-color="grammar">
            <div class="nav-card-icon" aria-hidden="true">
                <FluentIcon Icon="@(Icons.Regular.Size24.TextGrammarWand)" />
            </div>
            <div class="nav-card-body">
                <h2 class="nav-card-title">Ngữ pháp N5</h2>
                <p class="nav-card-desc">Các mẫu ngữ pháp JLPT N5 với giải thích và ví dụ minh họa.</p>
            </div>
            <FluentButton Appearance="@Appearance.Lightweight" Class="nav-card-btn" @onclick="@(() => Nav.NavigateTo("/grammar"))">
                Mở →
            </FluentButton>
        </div>

        <div class="nav-card" data-color="admin">
            <div class="nav-card-icon" aria-hidden="true">
                <FluentIcon Icon="@(Icons.Regular.Size24.Settings)" />
            </div>
            <div class="nav-card-body">
                <h2 class="nav-card-title">Quản trị</h2>
                <p class="nav-card-desc">Quản lý dữ liệu: thêm, sửa, xóa chữ cái, từ vựng, Kanji và ngữ pháp.</p>
            </div>
            <FluentButton Appearance="@Appearance.Lightweight" Class="nav-card-btn" @onclick="@(() => Nav.NavigateTo("/admin"))">
                Mở →
            </FluentButton>
        </div>
    </div>
</div>

<style>
    .home-container {
        max-width: 1080px;
        margin: 0 auto;
        padding: 1.5rem 0 3rem;
    }

    .home-hero {
        position: relative;
        display: flex;
        align-items: center;
        gap: 40px;
        padding: 48px 0 40px;
        overflow: hidden;
    }

    .hero-copy {
        position: relative;
        z-index: 1;
        flex: 1;
        min-width: 0;
    }

    .hero-kicker {
        margin: 0 0 12px;
        font-size: 0.78rem;
        font-weight: 600;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--accent-color);
    }

    .hero-title {
        margin: 0 0 16px;
        font-size: clamp(2.6rem, 6vw, 4.2rem);
        font-weight: 800;
        line-height: 1.05;
        letter-spacing: -0.03em;
        color: var(--text-primary);
    }

    .hero-dot {
        color: var(--accent-color);
    }

    .hero-subtitle {
        margin: 0 0 28px;
        max-width: 56ch;
        font-size: 1.05rem;
        line-height: 1.7;
        color: var(--text-secondary);
    }

    .hero-cta {
        display: flex;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
    }

    .cta-primary {
        min-width: 150px;
    }

    .hero-glyph {
        position: absolute;
        right: -8px;
        top: 50%;
        transform: translateY(-50%);
        font-family: var(--font-family);
        font-size: clamp(9rem, 22vw, 17rem);
        font-weight: 800;
        line-height: 1;
        color: var(--accent-color);
        opacity: 0.07;
        user-select: none;
        pointer-events: none;
    }

    .nav-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 20px;
    }

    .nav-card {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        text-align: left;
        background: var(--bg-card);
        border-radius: var(--radius-lg);
        padding: 24px;
        box-shadow: var(--shadow-sm);
        border: 1px solid var(--drawer-header-border);
        transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s;
    }

    .nav-card:hover {
        transform: translateY(-3px);
        box-shadow: var(--shadow-md);
        border-color: color-mix(in srgb, var(--accent-color) 35%, transparent);
    }

    .nav-card.featured {
        grid-column: span 2;
        background:
            radial-gradient(480px 220px at 92% -10%, var(--accent-soft) 0%, transparent 60%),
            var(--bg-card);
    }

    .nav-card-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 52px;
        height: 52px;
        border-radius: 14px;
        margin-bottom: 16px;
        color: var(--text-on-primary);
        box-shadow: 0 4px 14px rgba(43, 33, 31, 0.14);
    }

    .nav-card[data-color="alphabet"] .nav-card-icon { background: var(--icon-hiragana-bg); }
    .nav-card[data-color="words"] .nav-card-icon { background: var(--icon-word-bg); }
    .nav-card[data-color="practice"] .nav-card-icon { background: var(--practice-icon-bg); }
    .nav-card[data-color="quiz"] .nav-card-icon { background: var(--icon-hiragana-bg); }
    .nav-card[data-color="kanji"] .nav-card-icon { background: var(--icon-kanji-bg); }
    .nav-card[data-color="grammar"] .nav-card-icon { background: var(--icon-grammar-bg); }
    .nav-card[data-color="admin"] .nav-card-icon { background: var(--icon-word-bg); }

    .nav-card-body {
        flex-grow: 1;
    }

    .nav-card-title {
        font-size: 1.2rem;
        font-weight: 700;
        margin: 0 0 8px;
        color: var(--text-primary);
        letter-spacing: -0.01em;
    }

    .nav-card-desc {
        font-size: 0.9rem;
        color: var(--text-secondary);
        margin: 0 0 20px;
        line-height: 1.6;
    }

    .nav-card-btn {
        min-width: 96px;
    }

    @@media (max-width: 720px) {
        .nav-card.featured {
            grid-column: span 1;
        }
        .home-hero {
            padding-top: 24px;
        }
        .hero-glyph {
            display: none;
        }
    }
</style>
