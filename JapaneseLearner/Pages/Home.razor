@page "/"
@inject NavigationManager Nav

<PageTitle>Japanese Learner — Học tiếng Nhật</PageTitle>

<div class="home-container">
    <div class="hero-section">
        <div class="hero-icon" aria-hidden="true">
            <FluentIcon Icon="@(Icons.Regular.Size48.BookContacts)" />
        </div>
        <h1 class="hero-title">Japanese Learner</h1>
        <p class="hero-subtitle">
            Ứng dụng học tiếng Nhật toàn diện — từ bảng chữ cái, từ vựng đến Kanji.
            Luyện tập mỗi ngày để tiến bộ nhanh hơn!
        </p>
    </div>

    <div class="nav-grid">
        <div class="nav-card" data-color="alphabet">
            <div class="nav-card-icon">
                <FluentIcon Icon="@(Icons.Regular.Size32.BookContacts)" />
            </div>
            <h2 class="nav-card-title">Bảng chữ cái</h2>
            <p class="nav-card-desc">Học Hiragana và Katakana qua flashcard. Luyện gõ Romaji để ghi nhớ mặt chữ.</p>
            <FluentButton Appearance="@Appearance.Accent" Class="nav-card-btn" @onclick="@(() => Nav.NavigateTo("/alphabet"))">
                Bắt đầu
            </FluentButton>
        </div>

        <div class="nav-card" data-color="words">
            <div class="nav-card-icon">
                <FluentIcon Icon="@(Icons.Regular.Size32.Document)" />
            </div>
            <h2 class="nav-card-title">Từ vựng</h2>
            <p class="nav-card-desc">Học từ vựng tiếng Nhật theo chủ đề với flashcard và phiên âm chi tiết.</p>
            <FluentButton Appearance="@Appearance.Accent" Class="nav-card-btn" @onclick="@(() => Nav.NavigateTo("/words"))">
                Bắt đầu
            </FluentButton>
        </div>

        <div class="nav-card" data-color="quiz">
            <div class="nav-card-icon">
                <FluentIcon Icon="@(Icons.Regular.Size32.Target)" />
            </div>
            <h2 class="nav-card-title">Quiz từ vựng</h2>
            <p class="nav-card-desc">Kiểm tra kiến thức từ vựng với câu hỏi trắc nghiệm nhiều lựa chọn.</p>
            <FluentButton Appearance="@Appearance.Accent" Class="nav-card-btn" @onclick="@(() => Nav.NavigateTo("/words/quiz"))">
                Bắt đầu
            </FluentButton>
        </div>

        <div class="nav-card" data-color="kanji">
            <div class="nav-card-icon">
                <FluentIcon Icon="@(Icons.Regular.Size32.Compose)" />
            </div>
            <h2 class="nav-card-title">Kanji</h2>
            <p class="nav-card-desc">Tra cứu và học các chữ Kanji với âm đọc, nghĩa và ví dụ minh họa.</p>
            <FluentButton Appearance="@Appearance.Accent" Class="nav-card-btn" @onclick="@(() => Nav.NavigateTo("/kanji"))">
                Bắt đầu
            </FluentButton>
        </div>

        <div class="nav-card" data-color="admin">
            <div class="nav-card-icon">
                <FluentIcon Icon="@(Icons.Regular.Size32.Settings)" />
            </div>
            <h2 class="nav-card-title">Quản trị</h2>
            <p class="nav-card-desc">Quản lý dữ liệu: thêm, sửa, xóa chữ cái và từ vựng trong hệ thống.</p>
            <FluentButton Appearance="@Appearance.Accent" Class="nav-card-btn" @onclick="@(() => Nav.NavigateTo("/admin"))">
                Đi đến
            </FluentButton>
        </div>
    </div>
</div>

<style>
    .home-container {
        max-width: 900px;
        margin: 0 auto;
        padding: 2rem 1rem;
    }

    .hero-section {
        text-align: center;
        margin-bottom: 3rem;
    }

    .hero-icon {
        font-size: 3rem;
        margin-bottom: 1rem;
        color: var(--accent-fill-rest);
    }

    .hero-title {
        font-size: 2.5rem;
        font-weight: 700;
        margin: 0.5rem 0;
        color: var(--neutral-foreground-rest);
    }

    .hero-subtitle {
        font-size: 1.1rem;
        color: var(--neutral-foreground-hint);
        max-width: 600px;
        margin: 1rem auto 0;
        line-height: 1.6;
    }

    .nav-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 1.5rem;
    }

    .nav-card {
        background: var(--neutral-layer-3);
        border-radius: 12px;
        padding: 1.5rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        transition: transform 0.2s, box-shadow 0.2s;
        border: 1px solid var(--neutral-stroke-divider-rest);
    }

    .nav-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 8px 24px rgba(0,0,0,0.12);
    }

    .nav-card-icon {
        font-size: 2rem;
        margin-bottom: 1rem;
        color: var(--accent-fill-rest);
    }

    .nav-card-title {
        font-size: 1.25rem;
        font-weight: 600;
        margin: 0 0 0.5rem;
        color: var(--neutral-foreground-rest);
    }

    .nav-card-desc {
        font-size: 0.9rem;
        color: var(--neutral-foreground-hint);
        margin: 0 0 1.25rem;
        line-height: 1.5;
        flex-grow: 1;
    }

    .nav-card-btn {
        width: 100%;
    }
</style>
