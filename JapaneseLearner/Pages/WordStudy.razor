@page "/words"
@inject IWordService WordService

<PageTitle>Luyện từ - Japanese Learner</PageTitle>

<div class="word-study-container">
    <div class="study-header">
        <div class="study-header-title">
            <div class="study-header-icon word-icon" aria-hidden="true">
                <span>語</span>
            </div>
            <div>
                <h1>Luyện từ vựng</h1>
                <p class="study-header-sub">Gõ phiên âm Romaji của từ hiển thị</p>
            </div>
        </div>
        <div class="study-header-stats">
            <div class="stat-box stat-correct">
                <span class="stat-num">@correctCount</span>
                <span class="stat-label">Đúng</span>
            </div>
            <div class="stat-box stat-wrong">
                <span class="stat-num">@wrongCount</span>
                <span class="stat-label">Sai</span>
            </div>
        </div>
    </div>

    <div class="tab-bar">
        <button class="tab-btn @(selectedType == "All" ? "active" : "")" @onclick="@(() => SwitchType("All"))">Tất cả</button>
        <button class="tab-btn @(selectedType == "Seion" ? "active" : "")" @onclick="@(() => SwitchType("Seion"))">清音</button>
        <button class="tab-btn @(selectedType == "Dakuon" ? "active" : "")" @onclick="@(() => SwitchType("Dakuon"))">濁音</button>
        <button class="tab-btn @(selectedType == "Handakuon" ? "active" : "")" @onclick="@(() => SwitchType("Handakuon"))">半濁音</button>
        <button class="tab-btn @(selectedType == "Yoon" ? "active" : "")" @onclick="@(() => SwitchType("Yoon"))">拗音</button>
        <button class="tab-btn @(selectedType == "Sokuon" ? "active" : "")" @onclick="@(() => SwitchType("Sokuon"))">促音</button>
        <button class="tab-btn @(selectedType == "Choon" ? "active" : "")" @onclick="@(() => SwitchType("Choon"))">長音</button>
    </div>

    @if (isLoading)
    {
        <div class="loading-wrap">
            <FluentProgressRing />
        </div>
    }
    else if (availableWords.Count == 0)
    {
        <div class="empty-state">
            <div class="empty-icon"><FluentIcon Icon="@(Icons.Regular.Size20.Document)" /></div>
            <h3>Chưa có dữ liệu</h3>
            <p>Vui lòng thêm từ từ trang Admin để bắt đầu học.</p>
            <FluentButton Appearance="@Appearance.Accent" Href="/admin" Class="mt-4">
                Đến Admin
            </FluentButton>
        </div>
    }
    else
    {
        <div class="type-indicator">
            <span class="type-badge type-@currentWord?.Type?.ToLowerInvariant()">@GetTypeLabel(currentWord?.Type)</span>
        </div>

        <div class="study-card @(isCorrect == true ? "card-correct" : isCorrect == false ? "card-wrong" : "")">
            <div class="char-display">
                <span class="japanese-char-display @(GetCharCount() >= 4 ? "word-sm" : GetCharCount() >= 3 ? "word-md" : "")">@currentWord?.Characters</span>
            </div>
            <div class="romaji-hint" aria-hidden="true">
                <span class="hint-dot active">語</span>
            </div>
        </div>

        @if (isCorrect == true)
        {
            <div class="feedback feedback-correct">
                <span class="feedback-icon"><FluentIcon Icon="@(Icons.Regular.Size20.Checkmark)" /></span>
                Chính xác! (@currentWord?.Meaning)
            </div>
        }
        else if (isCorrect == false)
        {
            <div class="feedback feedback-wrong">
                <span class="feedback-icon"><FluentIcon Icon="@(Icons.Regular.Size20.Dismiss)" /></span>
                Đáp án đúng: <strong>@currentWord?.Romaji</strong>
                @if (!string.IsNullOrWhiteSpace(currentWord?.Meaning))
                {
                    <span class="meaning-hint">(@currentWord.Meaning)</span>
                }
            </div>
        }

        <div class="input-row">
            <div class="input-wrap">
                <FluentTextField @ref="inputRef" @bind-Value="userInput"
                                 Placeholder="Nhập Romaji..."
                                 Class="romaji-input"
                                 Disabled="@(isCorrect == true)"
                                 @onkeydown="HandleKeyDown" />
            </div>
            @if (isCorrect == true || isCorrect == false)
            {
                <FluentButton Appearance="@Appearance.Accent" OnClick="NextWord" Class="action-btn">
                    Tiếp →
                </FluentButton>
            }
            else
            {
                <FluentButton Appearance="@Appearance.Accent" OnClick="CheckAnswer"
                             Disabled="string.IsNullOrWhiteSpace(userInput)" Class="action-btn">
                    Kiểm tra
                </FluentButton>
            }
        </div>
    }
</div>

<style>
    .word-study-container {
        max-width: 520px;
        margin: 0 auto;
    }
    .meaning-hint {
        display: block;
        font-size: 0.85rem;
        font-weight: 400;
        margin-top: 4px;
        opacity: 0.8;
    }
</style>

@code {
    private List<JapaneseWord> availableWords = new();
    private JapaneseWord? currentWord;
    private string userInput = "";
    private bool? isCorrect;
    private string selectedType = "All";
    private int correctCount;
    private int wrongCount;
    private bool isLoading = true;
    private FluentTextField inputRef = default!;

    protected override async Task OnInitializedAsync()
    {
        await LoadWords();
        isLoading = false;
    }

    private async Task LoadWords()
    {
        availableWords = await WordService.GetByTypeAsync(selectedType);
        await PickRandomWord();
    }

    private async Task PickRandomWord()
    {
        if (availableWords.Count == 0) return;
        var rng = new Random();
        currentWord = availableWords[rng.Next(availableWords.Count)];
        userInput = "";
        isCorrect = null;
        if (inputRef != null)
            inputRef.FocusAsync();
    }

    private async Task CheckAnswer()
    {
        if (currentWord == null || string.IsNullOrWhiteSpace(userInput)) return;

        if (userInput.Trim().ToLowerInvariant() == currentWord.Romaji.ToLowerInvariant())
        {
            isCorrect = true;
            correctCount++;
            StateHasChanged();
            await Task.Delay(1000);
            await PickRandomWord();
        }
        else
        {
            isCorrect = false;
            wrongCount++;
        }
    }

    private async Task NextWord()
    {
        await PickRandomWord();
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            if (isCorrect == true || isCorrect == false)
            {
                await NextWord();
            }
            else
            {
                await CheckAnswer();
            }
        }
    }

    private async Task SwitchType(string type)
    {
        selectedType = type;
        await LoadWords();
    }

    private int GetCharCount()
    {
        return currentWord?.Characters?.Length ?? 0;
    }

    private string GetTypeLabel(string? type)
    {
        return type switch
        {
            "Seion" => "清音 (Âm cơ bản)",
            "Dakuon" => "濁音 (Âm đục)",
            "Handakuon" => "半濁音 (Âm bán đục)",
            "Yoon" => "拗音 (Âm ghép)",
            "Sokuon" => "促音 (Âm ngắt)",
            "Choon" => "長音 (Âm dài)",
            _ => ""
        };
    }
}
