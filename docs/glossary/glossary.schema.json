{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aios://glossary.schema.json",
  "title": "AIOS Glossary Term (Domain Model)",
  "description": "JSON Schema cho frontmatter của từng term file trong docs/glossary/terms/. Validator kiểm tra template D002 Domain Model.",
  "type": "object",
  "required": [
    "id", "name", "version", "since", "status", "category", "owner", "stability",
    "tags", "aliases", "deprecated_aliases", "summary", "definition", "purpose",
    "entity_type", "normative", "responsibilities", "does_not_responsible",
    "owned_by", "used_by", "depends_on", "inputs", "outputs", "lifecycle",
    "states", "invariants", "related", "examples", "references"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^TERM-\\d{3}$" },
    "name": { "type": "string" },
    "version": { "type": "string" },
    "since": { "type": "string" },
    "status": { "enum": ["Draft", "Review", "Approved", "Deprecated"] },
    "category": { "enum": ["Core", "Execution", "EntryPoint", "Data", "Knowledge", "Platform", "Extension"] },
    "owner": { "type": "string" },
    "stability": { "enum": ["Stable", "Experimental", "Deprecated"] },
    "tags": { "type": "array", "items": { "type": "string" } },
    "aliases": { "type": "array", "items": { "type": "string" } },
    "deprecated_aliases": { "type": "array", "items": { "type": "string" } },
    "summary": { "type": "string" },
    "definition": { "type": "string" },
    "purpose": { "type": "string" },
    "entity_type": { "enum": ["Service", "Definition", "Execution", "Data", "Message", "Extension"] },
    "normative": {
      "type": "object",
      "required": ["MUST", "MUST NOT"],
      "properties": {
        "MUST": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "MUST NOT": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "SHOULD": { "type": "array", "items": { "type": "string" } },
        "MAY": { "type": "array", "items": { "type": "string" } }
      }
    },
    "responsibilities": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "does_not_responsible": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "owned_by": { "type": "string" },
    "used_by": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "depends_on": { "type": "array", "items": { "type": "string", "pattern": "^TERM-\\d{3}$" } },
    "inputs": { "type": "array", "items": { "type": "string" } },
    "outputs": { "type": "array", "items": { "type": "string" } },
    "lifecycle": { "type": "string" },
    "states": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "invariants": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "related": { "type": "array", "items": { "type": "string", "pattern": "^TERM-\\d{3}$" } },
    "examples": { "type": "array", "items": { "type": "string" } },
    "references": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
