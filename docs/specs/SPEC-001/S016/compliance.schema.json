{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aios://compliance.schema.json",
  "title": "SPEC-001 Runtime Compliance (S016)",
  "description": "JSON Schema cho compliance.yaml. Validator kiem tra cau truc.",
  "type": "object",
  "required": ["id", "name", "version", "status", "owner", "philosophy", "principles", "scope", "validation_rules", "health_score", "readiness_checklist", "certification", "pipeline"],
  "properties": {
    "id": { "const": "SPEC-001-S016" },
    "name": { "const": "Runtime Compliance" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "status": { "enum": ["Draft", "Review", "Approved", "Stable", "Deprecated"] },
    "owner": { "type": "string" },
    "philosophy": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "principles": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "scope": { "type": "object", "required": ["verifies"] },
    "validation_rules": { "type": "array", "items": { "type": "string" }, "minItems": 23 },
    "health_score": { "type": "array", "items": { "type": "string" }, "minItems": 3 },
    "readiness_checklist": { "type": "array", "items": { "type": "string" }, "minItems": 7 },
    "certification": { "type": "object", "required": ["levels", "requirements"] },
    "pipeline": { "type": "array", "items": { "type": "string" }, "minItems": 4 },
    "events": { "type": "array", "items": { "type": "string" } },
    "metrics": { "type": "object" }
  },
  "additionalProperties": false
}
