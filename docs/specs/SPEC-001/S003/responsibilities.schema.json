{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aios://responsibilities.schema.json",
  "title": "SPEC-001 Runtime Responsibilities (S003 v3.1)",
  "description": "JSON Schema cho responsibilities.yaml. Validator kiem tra cau truc.",
  "type": "object",
  "required": ["id", "name", "version", "status", "owner", "responsibilities"],
  "properties": {
    "id": { "const": "SPEC-001-S003" },
    "name": { "const": "Runtime Responsibilities" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "status": { "enum": ["Draft", "Review", "Approved", "Stable", "Deprecated"] },
    "owner": { "type": "string" },
    "frozen": { "type": "boolean" },
    "frozen_date": { "type": "string", "format": "date" },
    "principle": { "type": "string" },
    "invariants": { "type": "array", "items": { "type": "string" } },
    "delegation": { "type": "object", "additionalProperties": { "type": "string" } },
    "responsibilities": {
      "type": "object",
      "patternProperties": {
        "^RR-\\d{3}$": {
          "type": "object",
          "required": ["name", "group", "owner", "priority", "status", "authority", "input", "output", "metric", "requirements", "principles"],
          "properties": {
            "name": { "type": "string" },
            "group": { "enum": ["Core", "Execution", "Context", "State", "Coordination", "Observability", "Artifact", "Governance"] },
            "owner": { "type": "string" },
            "priority": { "enum": ["Critical", "High", "Medium", "Low"] },
            "status": { "enum": ["Draft", "Approved", "Implemented", "Verified", "Stable"] },
            "authority": { "type": "string" },
            "input": { "type": "string" },
            "output": { "type": "string" },
            "metric": { "type": "string" },
            "requirements": { "type": "array", "items": { "type": "string", "pattern": "^FR-\\d{3}$" } },
            "principles": { "type": "array", "items": { "type": "string", "pattern": "^P\\d{3}$" }, "minItems": 1 },
            "rules": { "type": "array", "items": { "type": "string", "pattern": "^RULE-\\d{3}$" } }
          }
        }
      }
    }
  },
  "additionalProperties": false
}
