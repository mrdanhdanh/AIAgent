{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aios://responsibilities.schema.json",
  "title": "SPEC-001 Runtime Responsibilities (S003)",
  "description": "JSON Schema cho responsibilities.yaml. Validator kiem tra cau truc.",
  "type": "object",
  "required": ["id", "name", "version", "status", "owner", "responsibilities"],
  "properties": {
    "id": { "const": "SPEC-001-S003" },
    "name": { "const": "Runtime Responsibilities" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "status": { "enum": ["Draft", "Review", "Approved", "Stable", "Deprecated"] },
    "owner": { "type": "string" },
    "responsibilities": {
      "type": "object",
      "patternProperties": {
        "^RESP-\\d{3}$": {
          "type": "object",
          "required": ["name", "description", "priority", "category", "owner", "status", "requirements", "principles"],
          "properties": {
            "name": { "type": "string" },
            "description": { "type": "string" },
            "priority": { "enum": ["Critical", "High", "Medium", "Low"] },
            "category": { "enum": ["Core", "Execution", "State", "Data", "Events", "Observability", "Governance"] },
            "owner": { "type": "string" },
            "status": { "enum": ["Draft", "Approved", "Implemented", "Verified", "Stable"] },
            "requirements": { "type": "array", "items": { "type": "string", "pattern": "^FR-\\d{3}$" } },
            "principles": { "type": "array", "items": { "type": "string", "pattern": "^P\\d{3}$" }, "minItems": 1 },
            "rules": { "type": "array", "items": { "type": "string", "pattern": "^RULE-\\d{3}$" } }
          }
        }
      }
    }
  },
  "additionalProperties": false
}
