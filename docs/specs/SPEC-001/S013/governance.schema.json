{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aios://governance.schema.json",
  "title": "SPEC-001 Runtime Governance (S013)",
  "description": "JSON Schema cho governance.yaml. Validator kiem tra cau truc.",
  "type": "object",
  "required": ["id", "name", "version", "status", "owner", "philosophy", "principles", "scope", "version_governance", "compatibility_governance", "validation_pipeline", "decisions", "traceability"],
  "properties": {
    "id": { "const": "SPEC-001-S013" },
    "name": { "const": "Runtime Governance" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "status": { "enum": ["Draft", "Review", "Approved", "Stable", "Deprecated"] },
    "owner": { "type": "string" },
    "philosophy": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "principles": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "scope": {
      "type": "object",
      "required": ["enforces", "not_enforces"],
      "properties": {
        "enforces": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "not_enforces": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
      }
    },
    "version_governance": { "type": "object", "required": ["checks"] },
    "compatibility_governance": { "type": "object", "required": ["checks"] },
    "validation_pipeline": { "type": "array", "items": { "type": "string" }, "minItems": 5 },
    "decisions": { "type": "array", "items": { "type": "string" }, "minItems": 5 },
    "traceability": { "type": "array", "items": { "type": "string" }, "minItems": 5 }
  },
  "additionalProperties": false
}
