{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aios://observability.schema.json",
  "title": "SPEC-001 Runtime Observability (S011)",
  "description": "JSON Schema cho observability.yaml. Validator kiem tra cau truc.",
  "type": "object",
  "required": ["id", "name", "version", "status", "owner", "philosophy", "principles", "models"],
  "properties": {
    "id": { "const": "SPEC-001-S011" },
    "name": { "const": "Runtime Observability" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "status": { "enum": ["Draft", "Review", "Approved", "Stable", "Deprecated"] },
    "owner": { "type": "string" },
    "philosophy": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "principles": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "models": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
  },
  "additionalProperties": false
}
