{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aios://boundaries.schema.json",
  "title": "SPEC-001 Runtime Boundaries (S004 v2.1)",
  "description": "JSON Schema cho boundaries.yaml. Validator kiem tra cau truc.",
  "type": "object",
  "required": ["id", "name", "version", "status", "owner", "hierarchy", "decision", "invariants", "validation", "boundaries", "mapping"],
  "properties": {
    "id": { "const": "SPEC-001-S004" },
    "name": { "const": "Runtime Boundaries" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "frozen": { "type": "boolean" },
    "frozen_date": { "type": "string", "format": "date" },
    "status": { "enum": ["Draft", "Review", "Approved", "Stable", "Deprecated"] },
    "owner": { "type": "string" },
    "hierarchy": { "type": "object" },
    "decision": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "invariants": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "validation": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "boundaries": {
      "type": "object",
      "patternProperties": {
        "^B\\d{3}-[a-z]+$": {
          "type": "object",
          "required": ["name", "severity", "version", "status", "principles", "rules", "violation", "impact", "detected_by", "metric", "target"],
          "properties": {
            "name": { "type": "string" },
            "severity": { "enum": ["Critical", "High", "Medium", "Low"] },
            "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
            "status": { "enum": ["Stable", "Experimental", "Deprecated"] },
            "principles": { "type": "array", "items": { "type": "string", "pattern": "^P\\d{3}$" }, "minItems": 1 },
            "rules": { "type": "array", "items": { "type": "string", "pattern": "^RULE-\\d{3}$" }, "minItems": 1 },
            "violation": { "type": "string" },
            "impact": { "enum": ["Critical", "High", "Medium", "Low"] },
            "detected_by": { "type": "string" },
            "metric": { "type": "string" },
            "target": { "type": "string" },
            "owns": { "type": "array", "items": { "type": "string" } },
            "not_owns": { "type": "array", "items": { "type": "string" } },
            "allowed": { "type": "array", "items": { "type": "string" } },
            "forbidden": { "type": "array", "items": { "type": "string" } },
            "delegates": { "type": "object" },
            "allowed_dependencies": { "type": "array", "items": { "type": "string" } },
            "forbidden_dependencies": { "type": "array", "items": { "type": "string" } },
            "exposes": { "type": "object" },
            "not_exposes": { "type": "array", "items": { "type": "string" } },
            "manages": { "type": "array", "items": { "type": "string" } },
            "not_manages": { "type": "array", "items": { "type": "string" } },
            "processes": { "type": "array", "items": { "type": "string" } },
            "not_processes": { "type": "array", "items": { "type": "string" } },
            "responsible": { "type": "array", "items": { "type": "string" } },
            "not_responsible": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },
    "mapping": { "type": "object" },
    "metrics": { "type": "object" }
  },
  "additionalProperties": false
}
