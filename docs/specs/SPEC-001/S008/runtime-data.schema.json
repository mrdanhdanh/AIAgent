{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aios://runtime-data.schema.json",
  "title": "SPEC-001 Runtime Data Model (S008 v2.1)",
  "description": "JSON Schema cho runtime-data-model.yaml. Validator kiem tra cau truc.",
  "type": "object",
  "required": ["version", "aggregate_root", "aggregate_rules", "classification", "invariants", "consistency", "dependencies"],
  "properties": {
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "status": { "type": "string" },
    "frozen": { "type": "boolean" },
    "frozen_date": { "type": "string", "format": "date" },
    "aggregate_root": { "const": "Execution" },
    "aggregate_rules": { "type": "array", "items": { "oneOf": [ { "type": "string" }, { "type": "object", "additionalProperties": { "type": "array", "items": { "type": "string" } } } ] }, "minItems": 1 },
    "classification": {
      "type": "object",
      "properties": {
        "not_manages": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
      },
      "additionalProperties": { "type": "array", "items": { "type": "string" } }
    },
    "invariants": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "consistency": {
      "type": "object",
      "required": ["levels", "rules"],
      "properties": {
        "levels": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "rules": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
      }
    },
    "dependencies": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
  },
  "additionalProperties": false
}
