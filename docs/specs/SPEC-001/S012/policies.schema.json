{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aios://policies.schema.json",
  "title": "SPEC-001 Runtime Policies (S012)",
  "description": "JSON Schema cho policies.yaml. Validator kiem tra cau truc.",
  "type": "object",
  "required": ["id", "name", "version", "status", "owner", "philosophy", "principles", "policy_model", "lifecycle", "scopes", "categories", "policies"],
  "properties": {
    "id": { "const": "SPEC-001-S012" },
    "name": { "const": "Runtime Policies" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "status": { "enum": ["Draft", "Review", "Approved", "Stable", "Deprecated"] },
    "owner": { "type": "string" },
    "philosophy": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "principles": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "policy_model": {
      "type": "object",
      "required": ["fields"],
      "properties": {
        "fields": { "type": "array", "items": { "type": "string" }, "minItems": 13 }
      }
    },
    "lifecycle": { "type": "array", "items": { "type": "string" }, "minItems": 6 },
    "scopes": { "type": "array", "items": { "type": "string" }, "minItems": 6 },
    "categories": { "type": "array", "items": { "type": "string" }, "minItems": 7 },
    "policies": { "type": "array", "items": { "type": "string" }, "minItems": 10 },
    "responsibility_chain": { "type": "array", "items": { "type": "string" }, "minItems": 3 }
  },
  "additionalProperties": false
}
