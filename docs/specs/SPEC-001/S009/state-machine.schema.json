{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aios://state-machine.schema.json",
  "title": "SPEC-001 Runtime State Machine (S009)",
  "description": "JSON Schema cho state-machine.yaml. Validator kiem tra cau truc.",
  "type": "object",
  "required": ["id", "name", "version", "status", "owner", "philosophy", "state_categories", "state_machines", "mapping"],
  "properties": {
    "id": { "const": "SPEC-001-S009" },
    "name": { "const": "Runtime State Machine" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "status": { "enum": ["Draft", "Review", "Approved", "Stable", "Deprecated"] },
    "owner": { "type": "string" },
    "philosophy": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "state_categories": { "type": "object" },
    "state_machines": {
      "type": "object",
      "patternProperties": {
        "^(Execution|Task|Workflow|Context|Contract|Artifact|Capability)$": {
          "type": "object",
          "required": ["model", "owner", "states", "initial_state", "terminal_states", "transitions"],
          "properties": {
            "model": { "type": "string", "pattern": "^RM-\\d{3}$" },
            "owner": { "type": "string" },
            "states": { "type": "array", "items": { "type": "string" }, "minItems": 2 },
            "initial_state": { "type": "string" },
            "terminal_states": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
            "recovery_states": { "type": "array", "items": { "type": "string" } },
            "invariants": { "type": "array", "items": { "type": "string" } },
            "transitions": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["from", "to", "event", "guard"],
                "properties": {
                  "from": { "type": "string" },
                  "to": { "type": "string" },
                  "event": { "type": "string" },
                  "guard": { "type": "string" }
                }
              },
              "minItems": 2
            }
          }
        }
      }
    },
    "mapping": { "type": "object" }
  },
  "additionalProperties": false
}
