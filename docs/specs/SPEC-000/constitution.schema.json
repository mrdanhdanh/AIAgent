{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aios://constitution.schema.json",
  "title": "AIOS Constitution (SPEC-000)",
  "description": "JSON Schema cho SPEC-000 Constitution (C002). Validator kiem tra metadata.",
  "type": "object",
  "required": ["id", "name", "version", "status", "type", "authority", "owner", "description", "dependencies", "includes", "outputs", "authoritative", "breaking_change_requires", "references", "constitution_version", "frozen"],
  "properties": {
    "id": { "const": "SPEC-000" },
    "name": { "const": "AIOS Constitution" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "status": { "enum": ["Draft", "Review", "Approved", "Stable", "Deprecated"] },
    "type": { "const": "Constitution" },
    "authority": { "const": "Highest" },
    "owner": { "type": "string" },
    "description": { "type": "string" },
    "dependencies": { "type": "array", "items": { "type": "string" } },
    "includes": { "type": "array", "items": { "enum": ["Manifest", "Glossary", "Principles", "Rules", "Governance"] }, "minItems": 5 },
    "outputs": { "type": "array", "items": { "enum": ["Constitution", "Cross Reference", "Compliance Matrix", "Dependency Graph"] } },
    "authoritative": { "const": true },
    "constitution_version": { "type": "string" },
    "frozen": { "const": true },
    "breaking_change_requires": { "type": "array", "items": { "enum": ["ADR", "RFC"] }, "minItems": 2 },
    "references": {
      "type": "object",
      "required": ["manifest", "glossary", "principles", "rules", "governance"],
      "properties": {
        "manifest": { "type": "string" },
        "glossary": { "type": "string" },
        "principles": { "type": "string" },
        "rules": { "type": "string" },
        "governance": { "type": "string" }
      }
    }
  },
  "additionalProperties": false
}
