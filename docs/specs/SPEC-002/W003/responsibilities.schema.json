{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aios://workflow-responsibilities.schema.json",
  "title": "SPEC-002 Workflow Responsibilities (W003)",
  "description": "JSON Schema cho responsibilities.yaml. Validator kiem tra cau truc.",
  "type": "object",
  "required": ["id", "name", "version", "status", "frozen", "owner", "principle", "invariants", "delegation", "responsibilities"],
  "properties": {
    "id": { "const": "SPEC-002-W003" },
    "name": { "const": "Workflow Responsibilities" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "status": { "enum": ["Draft", "Review", "Approved", "Stable", "Deprecated"] },
    "frozen": { "type": "boolean" },
    "owner": { "type": "string" },
    "principle": { "type": "string" },
    "invariants": { "type": "array", "items": { "type": "string" }, "minItems": 4 },
    "delegation": { "type": "object" },
    "responsibilities": { "type": "object", "minProperties": 18 }
  },
  "additionalProperties": false
}
