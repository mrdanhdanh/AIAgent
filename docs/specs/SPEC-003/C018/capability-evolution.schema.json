{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aios://capability-evolution.schema.json",
  "title": "SPEC-003 Capability Evolution (C018)",
  "type": "object",
  "required": ["id", "name", "version", "status", "frozen", "owner", "philosophy", "principles", "scope", "pipeline", "proposal_model", "proposal_status", "approval", "safety", "application", "traceability"],
  "properties": {
    "id": { "const": "SPEC-003-C018" },
    "name": { "const": "Capability Evolution" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "status": { "enum": ["Draft", "Review", "Approved", "Stable", "Deprecated"] },
    "frozen": { "type": "boolean" },
    "owner": { "type": "string" },
    "philosophy": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "principles": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "scope": { "type": "object", "required": ["reads", "not_reads"] },
    "pipeline": { "type": "array", "items": { "type": "string" }, "minItems": 6 },
    "proposal_model": { "type": "object", "required": ["fields"] },
    "proposal_status": { "type": "array", "items": { "type": "string" }, "minItems": 6 },
    "approval": { "type": "array", "items": { "type": "string" }, "minItems": 4 },
    "safety": { "type": "array", "items": { "type": "string" }, "minItems": 4 },
    "application": { "type": "array", "items": { "type": "string" }, "minItems": 3 },
    "traceability": { "type": "array", "items": { "type": "string" }, "minItems": 4 },
    "events": { "type": "array", "items": { "type": "string" } },
    "metrics": { "type": "object" }
  },
  "additionalProperties": false
}