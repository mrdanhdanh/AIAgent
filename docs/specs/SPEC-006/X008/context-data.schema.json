{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aios://context-data.schema.json",
  "title": "SPEC-006 Context Data Model (X008)",
  "type": "object",
  "properties": {
    "schema": { "const": "context-data-model" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "entityId": { "type": "string", "format": "uuid" },
    "sectionKey": { "type": "string", "minLength": 1 },
    "itemKey": { "type": "string", "pattern": "^[a-z][a-z0-9.-]*$" },
    "itemValue": { "type": [ "string", "number", "boolean", "object", "array", "null" ] },
    "ttl": { "type": "integer", "minimum": 1 }
  },
  "required": [ "schema", "version" ],
  "additionalProperties": true
}
