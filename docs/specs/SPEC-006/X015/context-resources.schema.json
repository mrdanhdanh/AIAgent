{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aios://context-resources.schema.json",
  "title": "SPEC-006 Context Resources (X015)",
  "type": "object",
  "properties": {
    "schema": { "const": "context-resources" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "resource_id": { "type": "string", "pattern": "^XRES-[0-9]{3}$" }
  },
  "required": [ "schema", "version" ],
  "additionalProperties": true
}
