    "owner": { "type": "string" }, "philosophy": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "principles": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "categories": { "type": "array", "items": { "type": "string" }, "minItems": 5 },
    "extension_model": { "type": "object", "required": ["fields"] },
    "lifecycle": { "type": "array", "items": { "type": "string" }, "minItems": 6 },
