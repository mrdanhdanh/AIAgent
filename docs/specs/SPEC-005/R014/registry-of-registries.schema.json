    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "status": { "enum": ["Draft","Review","Approved","Stable","Deprecated"] }, "frozen": { "type": "boolean" },
    "owner": { "type": "string" }, "philosophy": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "principles": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "categories": { "type": "array", "items": { "type": "string" }, "minItems": 6 },
    "entry_model": { "type": "object", "required": ["fields"] }, "ownership": { "type": "object" },
    "lifecycle": { "type": "array", "items": { "type": "string" }, "minItems": 4 },
    "governance": { "type": "array", "items": { "type": "string" }, "minItems": 5 },
    "constraints": { "type": "array", "items": { "type": "string" }, "minItems": 4 },
    "resolution": { "type": "array", "items": { "type": "string" }, "minItems": 5 },
    "resolution_rules": { "type": "array", "items": { "type": "string" }, "minItems": 2 },
    "events": { "type": "array", "items": { "type": "string" } }, "metrics": { "type": "object" } },
  "additionalProperties": false }