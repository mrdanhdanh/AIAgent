{ "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "aios://registry-of-registries.schema.json", "title": "SPEC-005 Registry-of-Registries (R014)", "type": "object",
  "required": ["id","name","version","status","frozen","owner","philosophy","principles","categories","entry_model","ownership","lifecycle","governance","constraints","resolution","resolution_rules","events","metrics"],
