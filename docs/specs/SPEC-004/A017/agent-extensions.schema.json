{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aios://agent-extensions.schema.json",
  "title": "SPEC-004 Agent Extensions (A017)",
  "type": "object",
  "required": ["id", "name", "version", "status", "frozen", "owner", "philosophy", "principles", "categories", "extension_model", "lifecycle", "installation", "activation_rules", "isolation", "security", "resources", "compatibility"],
  "properties": {
    "id": { "const": "SPEC-004-A017" },
    "name": { "const": "Agent Extensions" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "status": { "enum": ["Draft", "Review", "Approved", "Stable", "Deprecated"] },
    "frozen": { "type": "boolean" },
    "owner": { "type": "string" },
    "philosophy": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "principles": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "categories": { "type": "array", "items": { "type": "string" }, "minItems": 5 },
    "extension_model": { "type": "object", "required": ["fields"] },
    "lifecycle": { "type": "array", "items": { "type": "string" }, "minItems": 6 },
    "installation": { "type": "array", "items": { "type": "string" }, "minItems": 4 },
    "activation_rules": { "type": "array", "items": { "type": "string" }, "minItems": 4 },
    "isolation": { "type": "array", "items": { "type": "string" }, "minItems": 4 },
    "security": { "type": "array", "items": { "type": "string" }, "minItems": 2 },
    "resources": { "type": "array", "items": { "type": "string" }, "minItems": 2 },
    "compatibility": { "type": "array", "items": { "type": "string" }, "minItems": 4 },
    "events": { "type": "array", "items": { "type": "string" } },
    "metrics": { "type": "object" }
  },
  "additionalProperties": false
}