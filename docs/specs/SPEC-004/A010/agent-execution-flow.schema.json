{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aios://agent-execution-flow.schema.json",
  "title": "SPEC-004 Agent Execution Flow (A010)",
  "type": "object",
  "required": ["id", "name", "version", "status", "frozen", "owner", "philosophy", "principles", "stages", "canonical_flow", "agent_flows", "rules"],
  "properties": {
    "id": { "const": "SPEC-004-A010" },
    "name": { "const": "Agent Execution Flow" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "status": { "enum": ["Draft", "Review", "Approved", "Stable", "Deprecated"] },
    "frozen": { "type": "boolean" },
    "owner": { "type": "string" },
    "philosophy": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "principles": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "stages": { "type": "array", "items": { "type": "string" }, "minItems": 7 },
    "canonical_flow": { "type": "array", "items": { "type": "string" }, "minItems": 8 },
    "agent_flows": { "type": "array", "items": { "type": "string" }, "minItems": 7 },
    "rules": { "type": "array", "items": { "type": "string" }, "minItems": 5 }
  },
  "additionalProperties": false
}