{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aios://agent-models.schema.json",
  "title": "SPEC-004 Agent Canonical Models",
  "type": "object",
  "required": ["version", "status", "aggregate_root", "models"],
  "properties": {
    "version": { "type": "string" },
    "status": { "enum": ["Draft", "Review", "Approved", "Stable", "Deprecated"] },
    "aggregate_root": { "const": "Agent" },
    "models": { "type": "object", "minProperties": 8 }
  },
  "additionalProperties": false
}