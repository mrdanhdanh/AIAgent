{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aios://agent-architecture.schema.json",
  "title": "SPEC-004 Agent Architecture (A005)",
  "description": "JSON Schema cho architecture.yaml. Validator kiem tra cau truc.",
  "type": "object",
  "required": ["id", "name", "version", "status", "frozen", "owner", "vision", "decisions", "layers", "domains", "dependency_rules", "communication_rules", "invariants", "views", "quality", "constraints", "stability", "metrics", "validation", "mapping"],
  "properties": {
    "id": { "const": "SPEC-004-A005" },
    "name": { "const": "Agent Architecture" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "status": { "enum": ["Draft", "Review", "Approved", "Stable", "Deprecated"] },
    "frozen": { "type": "boolean" },
    "owner": { "type": "string" },
    "vision": { "type": "string" },
    "decisions": { "type": "array", "items": { "type": "string" }, "minItems": 8 },
    "layers": { "type": "object", "minProperties": 7 },
    "domains": { "type": "object", "minProperties": 6 },
    "dependency_rules": { "type": "array", "items": { "type": "string" }, "minItems": 6 },
    "communication_rules": { "type": "array", "items": { "type": "string" }, "minItems": 3 },
    "invariants": { "type": "array", "items": { "type": "string" }, "minItems": 7 },
    "views": { "type": "object" },
    "quality": { "type": "object" },
    "constraints": { "type": "array", "items": { "type": "string" }, "minItems": 7 },
    "stability": { "type": "object" },
    "metrics": { "type": "object" },
    "validation": { "type": "array", "items": { "type": "string" }, "minItems": 7 },
    "mapping": { "type": "object" }
  },
  "additionalProperties": false
}
