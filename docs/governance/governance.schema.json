{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aios://governance.schema.json",
  "title": "AIOS Governance Policy (D005)",
  "description": "JSON Schema cho frontmatter của từng policy file trong docs/governance/policies/. Validator kiểm tra template D005.",
  "type": "object",
  "required": [
    "id", "name", "status", "version", "category", "statement", "purpose",
    "rules", "allowed", "forbidden", "related_principles", "examples"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^POLICY-\\d{3}$" },
    "name": { "type": "string" },
    "status": { "enum": ["Draft", "Review", "Stable", "Deprecated"] },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "category": { "enum": ["Approval", "Versioning", "Compatibility", "Lifecycle", "Documentation", "Naming", "Plugin", "Security", "Quality", "Release", "Decision"] },
    "statement": { "type": "string" },
    "purpose": { "type": "string" },
    "rules": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "allowed": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "forbidden": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "related_principles": { "type": "array", "items": { "type": "string", "pattern": "^P\\d{3}$" }, "minItems": 1 },
    "examples": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
