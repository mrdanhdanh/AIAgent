@inherits LayoutComponentBase
@implements IDisposable
@inject IThemeService ThemeService

<FluentDesignTheme CustomColor="#E63946"
                   Mode="@(ThemeService.IsDarkMode ? DesignThemeModes.Dark : DesignThemeModes.Light)"
                   StorageName="japanese-learner-theme" />

<div class="app-layout" data-theme="@(ThemeService.IsDarkMode ? "dark" : "light")">
    <header class="app-bar">
        <div class="app-bar-inner">
            <FluentButton Appearance="@Appearance.Lightweight" class="nav-btn home-btn" Href="/">
                📖
            </FluentButton>
            <h1 class="app-title">
                <a href="/" class="home-link">Japanese Learner</a>
            </h1>
            <div class="app-bar-spacer"></div>
            <FluentButton Appearance="@Appearance.Lightweight" class="nav-btn theme-btn" OnClick="ToggleTheme" Title="Chuyển đổi giao diện">
                @(ThemeService.IsDarkMode ? "☀️" : "🌙")
            </FluentButton>
            <FluentButton Appearance="@Appearance.Lightweight" class="nav-btn" OnClick="@(() => _drawerOpen = !_drawerOpen)">
                ☰
            </FluentButton>
        </div>
    </header>

    @if (_drawerOpen)
    {
        <div class="drawer-overlay" @onclick="CloseDrawer"></div>
        <aside class="drawer-panel">
            <div class="drawer-header">
                <h3>Navigation</h3>
                <FluentButton Appearance="@Appearance.Lightweight" OnClick="CloseDrawer" Class="drawer-close">✕</FluentButton>
            </div>
            <FluentNavMenu>
                <FluentNavLink Href="/" Match="NavLinkMatch.All" OnClick="CloseDrawer">📖 Hiragana / Katakana</FluentNavLink>
                <FluentNavLink Href="/words" OnClick="CloseDrawer">📝 Word Study</FluentNavLink>
                <FluentNavLink Href="/words/quiz" OnClick="CloseDrawer">🎯 Word Quiz</FluentNavLink>
                <FluentNavLink Href="/admin" OnClick="CloseDrawer">⚙️ Admin</FluentNavLink>
            </FluentNavMenu>
        </aside>
    }

    <main class="page-wrapper">
        @Body
    </main>
</div>

@code {
    private bool _drawerOpen;

    protected override async Task OnInitializedAsync()
    {
        await ThemeService.GetCurrentModeAsync();
        ThemeService.OnThemeChanged += StateHasChanged;
    }

    private void CloseDrawer()
    {
        _drawerOpen = false;
    }

    private async Task ToggleTheme()
    {
        await ThemeService.ToggleAsync();
    }

    public void Dispose()
    {
        ThemeService.OnThemeChanged -= StateHasChanged;
    }
}
