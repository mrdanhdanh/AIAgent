@page "/admin"
@inject ICharService CharService
@inject IWordService WordService
@inject ISnackbar Snackbar

<PageTitle>Quản lý - Japanese Learner</PageTitle>

<div class="admin-container">
    <div class="tab-bar">
        <button class="tab-btn @(activeTab == "chars" ? "active" : "")" @onclick="SwitchToChars">
            <MudIcon Icon="@Icons.Material.Filled.FontDownload" Size="Size.Small" Class="tab-icon" />
            Bảng chữ cái
        </button>
        <button class="tab-btn @(activeTab == "words" ? "active" : "")" @onclick="SwitchToWords">
            <MudIcon Icon="@Icons.Material.Filled.TextSnippet" Size="Size.Small" Class="tab-icon" />
            Từ vựng
        </button>
    </div>

    @if (activeTab == "chars")
    {
        <div class="admin-header">
            <div class="admin-header-left">
                <div class="admin-icon">
                    <MudIcon Icon="@Icons.Material.Filled.FontDownload" />
                </div>
                <div>
                    <h2>Quản lý bảng chữ cái</h2>
                    <p class="admin-sub">Thêm, sửa, xóa các ký tự Hiragana và Katakana</p>
                </div>
            </div>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="OpenAddCharDialog" StartIcon="@Icons.Material.Filled.Add" Class="add-btn">
                Thêm chữ
            </MudButton>
        </div>

        @if (chars == null)
        {
            <div class="loading-wrap">
                <MudProgressCircular Indeterminate="true" Size="Size.Medium" Color="Color.Primary" />
            </div>
        }
        else if (chars.Count == 0)
        {
            <div class="empty-state">
                <div class="empty-icon">📝</div>
                <h3>Danh sách trống</h3>
                <p>Chưa có chữ cái nào. Hãy thêm chữ mới để bắt đầu.</p>
            </div>
        }
        else
        {
            <div class="table-wrap">
                <MudTable Items="chars" Hover="true" Striped="true" Elevation="0" Class="data-table">
                    <HeaderContent>
                        <MudTh>Chữ</MudTh>
                        <MudTh>Phiên âm</MudTh>
                        <MudTh>Loại</MudTh>
                        <MudTh>Hành động</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd><span class="table-char">@context.Character</span></MudTd>
                        <MudTd><code class="table-romaji">@context.Romaji</code></MudTd>
                        <MudTd>
                            <span class="type-badge @(context.Type == "Hiragana" ? "type-hira" : "type-kata")">
                                @context.Type
                            </span>
                        </MudTd>
                        <MudTd>
                            <div class="action-btns">
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" OnClick="() => OpenEditCharDialog(context)" Class="action-btn-icon" />
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="() => OpenDeleteCharConfirm(context)" Class="action-btn-icon" />
                            </div>
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            </div>
        }

        <MudDialog @bind-Visible="showCharDialog">
            <TitleContent>
                <MudText Typo="Typo.h6" Class="dialog-title">
                    <MudIcon Icon="@(isEditCharMode ? Icons.Material.Filled.Edit : Icons.Material.Filled.Add)" Class="mr-2" Color="Color.Primary" />
                    @(isEditCharMode ? "Sửa chữ" : "Thêm chữ mới")
                </MudText>
            </TitleContent>
            <DialogContent>
                <div class="dialog-fields">
                    <MudTextField @bind-Value="editingChar.Character" Label="Chữ Nhật" Required="true" For="@(() => editingChar.Character)" Variant="Variant.Outlined" />
                    <MudTextField @bind-Value="editingChar.Romaji" Label="Phiên âm (Romaji)" Required="true" For="@(() => editingChar.Romaji)" Variant="Variant.Outlined" />
                    <MudSelect @bind-Value="editingChar.Type" Label="Loại" Required="true" Variant="Variant.Outlined">
                        <MudSelectItem Value="@("Hiragana")">Hiragana</MudSelectItem>
                        <MudSelectItem Value="@("Katakana")">Katakana</MudSelectItem>
                    </MudSelect>
                </div>
            </DialogContent>
            <DialogActions>
                <MudButton OnClick="CancelCharDialog" Variant="Variant.Text" Color="Color.Default">Hủy</MudButton>
                <MudButton OnClick="SaveChar" Variant="Variant.Filled" Color="Color.Primary" Disabled="!IsCharFormValid">
                    @(isEditCharMode ? "Lưu thay đổi" : "Thêm vào danh sách")
                </MudButton>
            </DialogActions>
        </MudDialog>

        <MudDialog @bind-Visible="showCharDeleteConfirm">
            <TitleContent>
                <MudText Typo="Typo.h6" Color="Color.Error">
                    <MudIcon Icon="@Icons.Material.Filled.Warning" Class="mr-2" />
                    Xác nhận xóa
                </MudText>
            </TitleContent>
            <DialogContent>
                <MudText>Bạn có chắc muốn xóa chữ <strong>@charToDelete?.Character</strong> (@charToDelete?.Romaji)?</MudText>
            </DialogContent>
            <DialogActions>
                <MudButton OnClick="CancelCharDelete" Variant="Variant.Text">Hủy</MudButton>
                <MudButton OnClick="DeleteChar" Variant="Variant.Filled" Color="Color.Error">Xóa</MudButton>
            </DialogActions>
        </MudDialog>
    }

    @if (activeTab == "words")
    {
        <div class="admin-header">
            <div class="admin-header-left">
                <div class="admin-icon word-icon">
                    <MudIcon Icon="@Icons.Material.Filled.TextSnippet" />
                </div>
                <div>
                    <h2>Quản lý từ vựng</h2>
                    <p class="admin-sub">Thêm, sửa, xóa từ vựng tiếng Nhật</p>
                </div>
            </div>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="OpenAddWordDialog" StartIcon="@Icons.Material.Filled.Add" Class="add-btn">
                Thêm từ
            </MudButton>
        </div>

        @if (words == null)
        {
            <div class="loading-wrap">
                <MudProgressCircular Indeterminate="true" Size="Size.Medium" Color="Color.Primary" />
            </div>
        }
        else if (words.Count == 0)
        {
            <div class="empty-state">
                <div class="empty-icon">📖</div>
                <h3>Danh sách trống</h3>
                <p>Chưa có từ vựng nào. Hãy thêm từ mới để bắt đầu.</p>
            </div>
        }
        else
        {
            <div class="word-count">Tổng số: <strong>@words.Count</strong> từ</div>
            <div class="table-wrap">
                <MudTable Items="words" Hover="true" Striped="true" Elevation="0" Class="data-table">
                    <HeaderContent>
                        <MudTh>Từ</MudTh>
                        <MudTh>Phiên âm</MudTh>
                        <MudTh>Nghĩa</MudTh>
                        <MudTh>Loại âm</MudTh>
                        <MudTh>Level</MudTh>
                        <MudTh>Hành động</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd><span class="table-char">@context.Characters</span></MudTd>
                        <MudTd><code class="table-romaji">@context.Romaji</code></MudTd>
                        <MudTd><span class="table-meaning">@context.Meaning</span></MudTd>
                        <MudTd><span class="type-badge type-@context.Type?.ToLowerInvariant()">@GetTypeLabel(context.Type)</span></MudTd>
                        <MudTd><span class="level-badge">@context.Level</span></MudTd>
                        <MudTd>
                            <div class="action-btns">
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" OnClick="() => OpenEditWordDialog(context)" Class="action-btn-icon" />
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="() => OpenDeleteWordConfirm(context)" Class="action-btn-icon" />
                            </div>
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            </div>
        }

        <MudDialog @bind-Visible="showWordDialog">
            <TitleContent>
                <MudText Typo="Typo.h6" Class="dialog-title">
                    <MudIcon Icon="@(isEditWordMode ? Icons.Material.Filled.Edit : Icons.Material.Filled.Add)" Class="mr-2" Color="Color.Primary" />
                    @(isEditWordMode ? "Sửa từ" : "Thêm từ mới")
                </MudText>
            </TitleContent>
            <DialogContent>
                <div class="dialog-fields">
                    <MudTextField @bind-Value="editingWord.Characters" Label="Chữ Nhật" Required="true" Variant="Variant.Outlined" />
                    <MudTextField @bind-Value="editingWord.Romaji" Label="Phiên âm (Romaji)" Required="true" Variant="Variant.Outlined" />
                    <MudTextField @bind-Value="editingWord.Meaning" Label="Nghĩa" Required="true" Variant="Variant.Outlined" />
                    <MudSelect @bind-Value="editingWord.Type" Label="Loại âm" Required="true" Variant="Variant.Outlined">
                        <MudSelectItem Value="@("N5")">N5 (Tổng hợp)</MudSelectItem>
                        <MudSelectItem Value="@("Seion")">清音 (Âm cơ bản)</MudSelectItem>
                        <MudSelectItem Value="@("Dakuon")">濁音 (Âm đục)</MudSelectItem>
                        <MudSelectItem Value="@("Handakuon")">半濁音 (Âm bán đục)</MudSelectItem>
                        <MudSelectItem Value="@("Yoon")">拗音 (Âm ghép)</MudSelectItem>
                        <MudSelectItem Value="@("Sokuon")">促音 (Âm ngắt)</MudSelectItem>
                        <MudSelectItem Value="@("Choon")">長音 (Âm dài)</MudSelectItem>
                    </MudSelect>
                    <MudSelect @bind-Value="editingWord.Level" Label="JLPT Level" Required="true" Variant="Variant.Outlined">
                        <MudSelectItem Value="@("N5")">N5</MudSelectItem>
                        <MudSelectItem Value="@("N4")">N4</MudSelectItem>
                        <MudSelectItem Value="@("N3")">N3</MudSelectItem>
                        <MudSelectItem Value="@("N2")">N2</MudSelectItem>
                        <MudSelectItem Value="@("N1")">N1</MudSelectItem>
                    </MudSelect>
                </div>
            </DialogContent>
            <DialogActions>
                <MudButton OnClick="CancelWordDialog" Variant="Variant.Text" Color="Color.Default">Hủy</MudButton>
                <MudButton OnClick="SaveWord" Variant="Variant.Filled" Color="Color.Primary" Disabled="!IsWordFormValid">
                    @(isEditWordMode ? "Lưu thay đổi" : "Thêm vào danh sách")
                </MudButton>
            </DialogActions>
        </MudDialog>

        <MudDialog @bind-Visible="showWordDeleteConfirm">
            <TitleContent>
                <MudText Typo="Typo.h6" Color="Color.Error">
                    <MudIcon Icon="@Icons.Material.Filled.Warning" Class="mr-2" />
                    Xác nhận xóa
                </MudText>
            </TitleContent>
            <DialogContent>
                <MudText>Bạn có chắc muốn xóa từ <strong>@wordToDelete?.Characters</strong> (@wordToDelete?.Romaji)?</MudText>
            </DialogContent>
            <DialogActions>
                <MudButton OnClick="CancelWordDelete" Variant="Variant.Text">Hủy</MudButton>
                <MudButton OnClick="DeleteWord" Variant="Variant.Filled" Color="Color.Error">Xóa</MudButton>
            </DialogActions>
        </MudDialog>
    }
</div>

<style>
    .admin-container {
        max-width: 800px;
        margin: 0 auto;
    }
    .tab-bar {
        display: flex;
        gap: 6px;
        margin-bottom: 20px;
        background: white;
        border-radius: 14px;
        padding: 6px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.06);
    }
    .tab-btn {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 10px 16px;
        border-radius: 10px;
        border: none;
        background: transparent;
        color: #666;
        font-size: 0.9rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
        font-family: inherit;
    }
    .tab-btn:hover {
        background: #f0f0f0;
        color: #1d3557;
    }
    .tab-btn.active {
        background: #1d3557;
        color: white;
    }
    .tab-icon {
        margin-right: 4px;
    }
    .admin-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 16px;
        flex-wrap: wrap;
        gap: 12px;
    }
    .admin-header-left {
        display: flex;
        align-items: center;
        gap: 14px;
    }
    .admin-icon {
        width: 44px;
        height: 44px;
        background: linear-gradient(135deg, #457b9d, #1d3557);
        color: white;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .word-icon {
        background: linear-gradient(135deg, #2a9d8f, #1d3557);
    }
    .admin-header h2 {
        font-size: 1.3rem;
        font-weight: 700;
        color: #1d3557;
        margin: 0;
    }
    .admin-sub {
        font-size: 0.8rem;
        color: #666;
        margin: 2px 0 0 0;
    }
    .add-btn {
        border-radius: 10px !important;
        text-transform: none !important;
        font-weight: 600 !important;
        padding: 8px 20px !important;
    }
    .loading-wrap {
        display: flex;
        justify-content: center;
        padding: 60px 0;
    }
    .empty-state {
        text-align: center;
        padding: 60px 20px;
        background: white;
        border-radius: 16px;
        box-shadow: 0 2px 12px rgba(0,0,0,0.06);
    }
    .empty-icon { font-size: 3rem; margin-bottom: 12px; }
    .empty-state h3 { color: #1d3557; margin: 0 0 8px 0; }
    .empty-state p { color: #666; margin: 0; }
    .word-count {
        text-align: right;
        font-size: 0.85rem;
        color: #666;
        margin-bottom: 8px;
    }
    .table-wrap {
        background: white;
        border-radius: 16px;
        box-shadow: 0 2px 12px rgba(0,0,0,0.06);
        overflow: hidden;
    }
    .data-table {
        background: transparent;
    }
    .table-char {
        font-size: 1.2rem;
        font-family: 'Noto Sans JP', sans-serif;
        color: #1d3557;
    }
    .table-romaji {
        background: #f0f0f0;
        padding: 2px 8px;
        border-radius: 4px;
        font-size: 0.85rem;
        color: #457b9d;
    }
    .table-meaning {
        font-size: 0.9rem;
        color: #333;
    }
    .type-badge {
        display: inline-block;
        padding: 3px 12px;
        border-radius: 20px;
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.5px;
    }
    .type-hira {
        background: rgba(69,123,157,0.12);
        color: #457b9d;
    }
    .type-kata {
        background: rgba(230,57,70,0.1);
        color: #e63946;
    }
    .type-seion { background: rgba(69,123,157,0.12); color: #457b9d; }
    .type-dakuon { background: rgba(230,57,70,0.1); color: #e63946; }
    .type-handakuon { background: rgba(42,157,143,0.12); color: #2a9d8f; }
    .type-yoon { background: rgba(233,196,106,0.2); color: #b8860b; }
    .type-sokuon { background: rgba(168,218,220,0.3); color: #1d3557; }
    .type-choon { background: rgba(69,123,157,0.15); color: #1d3557; }
    .type-n5 { background: rgba(42,157,143,0.12); color: #2a9d8f; }
    .level-badge {
        display: inline-block;
        padding: 2px 10px;
        border-radius: 12px;
        font-size: 0.75rem;
        font-weight: 700;
        background: rgba(233,196,106,0.2);
        color: #8b6914;
    }
    .action-btns {
        display: flex;
        gap: 4px;
    }
    .action-btn-icon {
        transition: transform 0.15s;
    }
    .action-btn-icon:hover { transform: scale(1.1); }
    .dialog-title {
        display: flex;
        align-items: center;
    }
    .dialog-fields {
        display: flex;
        flex-direction: column;
        gap: 16px;
        padding: 8px 0;
    }
</style>

@code {
    private string activeTab = "chars";

    // Char state
    private List<JapaneseChar> chars = new();
    private bool showCharDialog;
    private bool isEditCharMode;
    private JapaneseChar editingChar = new();
    private bool showCharDeleteConfirm;
    private JapaneseChar? charToDelete;

    // Word state
    private List<JapaneseWord> words = new();
    private bool showWordDialog;
    private bool isEditWordMode;
    private JapaneseWord editingWord = new();
    private bool showWordDeleteConfirm;
    private JapaneseWord? wordToDelete;

    private bool IsCharFormValid =>
        !string.IsNullOrWhiteSpace(editingChar.Character) &&
        !string.IsNullOrWhiteSpace(editingChar.Romaji);

    private bool IsWordFormValid =>
        !string.IsNullOrWhiteSpace(editingWord.Characters) &&
        !string.IsNullOrWhiteSpace(editingWord.Romaji) &&
        !string.IsNullOrWhiteSpace(editingWord.Meaning);

    protected override async Task OnInitializedAsync()
    {
        await RefreshCharList();
    }

    private void SwitchToChars()
    {
        activeTab = "chars";
    }

    private void SwitchToWords()
    {
        activeTab = "words";
        if (words.Count == 0)
            _ = RefreshWordList();
    }

    // ===== Char CRUD =====
    private async Task RefreshCharList()
    {
        chars = await CharService.GetAllAsync();
    }

    private void OpenAddCharDialog()
    {
        editingChar = new JapaneseChar { Type = "Hiragana" };
        isEditCharMode = false;
        showCharDialog = true;
    }

    private void OpenEditCharDialog(JapaneseChar c)
    {
        editingChar = new JapaneseChar
        {
            Id = c.Id,
            Character = c.Character,
            Romaji = c.Romaji,
            Type = c.Type
        };
        isEditCharMode = true;
        showCharDialog = true;
    }

    private async Task SaveChar()
    {
        if (!IsCharFormValid) return;

        if (isEditCharMode)
            await CharService.UpdateAsync(editingChar);
        else
            await CharService.AddAsync(editingChar);

        showCharDialog = false;
        await RefreshCharList();
    }

    private void CancelCharDialog()
    {
        showCharDialog = false;
    }

    private void OpenDeleteCharConfirm(JapaneseChar c)
    {
        charToDelete = c;
        showCharDeleteConfirm = true;
    }

    private async Task DeleteChar()
    {
        if (charToDelete != null)
        {
            await CharService.DeleteAsync(charToDelete.Id);
            charToDelete = null;
        }
        showCharDeleteConfirm = false;
        await RefreshCharList();
    }

    private void CancelCharDelete()
    {
        showCharDeleteConfirm = false;
        charToDelete = null;
    }

    // ===== Word CRUD =====
    private async Task RefreshWordList()
    {
        words = await WordService.GetAllAsync();
    }

    private void OpenAddWordDialog()
    {
        editingWord = new JapaneseWord { Type = "N5", Level = "N5" };
        isEditWordMode = false;
        showWordDialog = true;
    }

    private void OpenEditWordDialog(JapaneseWord w)
    {
        editingWord = new JapaneseWord
        {
            Id = w.Id,
            Characters = w.Characters,
            Romaji = w.Romaji,
            Meaning = w.Meaning,
            Type = w.Type,
            Level = w.Level
        };
        isEditWordMode = true;
        showWordDialog = true;
    }

    private async Task SaveWord()
    {
        if (!IsWordFormValid) return;

        if (isEditWordMode)
            await WordService.UpdateAsync(editingWord);
        else
            await WordService.AddAsync(editingWord);

        showWordDialog = false;
        await RefreshWordList();
        Snackbar.Add(isEditWordMode ? "Đã cập nhật từ" : "Đã thêm từ mới", Severity.Success);
    }

    private void CancelWordDialog()
    {
        showWordDialog = false;
    }

    private void OpenDeleteWordConfirm(JapaneseWord w)
    {
        wordToDelete = w;
        showWordDeleteConfirm = true;
    }

    private async Task DeleteWord()
    {
        if (wordToDelete != null)
        {
            await WordService.DeleteAsync(wordToDelete.Id);
            wordToDelete = null;
        }
        showWordDeleteConfirm = false;
        await RefreshWordList();
        Snackbar.Add("Đã xóa từ", Severity.Success);
    }

    private void CancelWordDelete()
    {
        showWordDeleteConfirm = false;
        wordToDelete = null;
    }

    private string GetTypeLabel(string? type)
    {
        return type switch
        {
            "Seion" => "清音",
            "Dakuon" => "濁音",
            "Handakuon" => "半濁音",
            "Yoon" => "拗音",
            "Sokuon" => "促音",
            "Choon" => "長音",
            "N5" => "N5",
            _ => type ?? ""
        };
    }
}
